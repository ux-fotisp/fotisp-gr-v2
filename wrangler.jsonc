{
	// Cloudflare Pages — fotisp-gr-v2
	// Static output: Astro builds to dist/, Pages serves it.
	// Workers are in functions/ (file-based routing).
	"name": "fotisp-gr-v2",
	"pages_build_output_dir": "dist",
	"compatibility_date": "2024-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "fotisp_db",
			"database_name": "fotisp-db",
			"database_id": "168e7737-ecea-4c82-85a3-dbdd1e0c5fae",
			"remote": true
		}
	]
}