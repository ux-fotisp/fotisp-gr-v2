---
export interface TokenCounter {
  value: string;
  label: string;
}

interface Props {
  headerLabel?: string;
  counters?: TokenCounter[];
  swatches?: string[];
  activeTokenTag?: string;
}

const {
  headerLabel = 'A shared source of truth',
  counters = [
    { value: '48', label: 'Components' },
    { value: '8', label: 'Token tiers' },
    { value: '24', label: 'Validated objects' },
  ],
  swatches = ['#FF3B4E', '#EE2626', '#F4F4F5', '#9E8E91', '#380F15'],
  activeTokenTag = '--color-accent: #EE2626',
} = Astro.props;
---

<div class="swatch-widget" role="region" aria-label={headerLabel}>
  <div class="swatch-widget__top">
    <span class="swatch-widget__title">{headerLabel}</span>
    <span class="swatch-widget__spec">ATOMIC // TS-ZOD</span>
  </div>

  <div class="swatch-widget__counters">
    {counters.map((c) => (
      <div class="token-box">
        <span class="token-box__val">{c.value}</span>
        <span class="token-box__lbl">{c.label}</span>
      </div>
    ))}
  </div>

  <div class="swatch-strip" aria-label="Design system color palette">
    {swatches.map((hex) => (
      <div
        class="swatch-chip"
        style={`background-color: ${hex};`}
        title={hex}
        data-hex={hex}
      >
        <span class="swatch-chip__label">{hex}</span>
      </div>
    ))}
  </div>

  <div class="swatch-widget__footer">
    <span class="token-pill">{activeTokenTag}</span>
    <span class="token-sync">FIGMA ↔ GIT SYNCED</span>
  </div>
</div>

<style>
  .swatch-widget {
    background: rgba(10, 6, 8, 0.9);
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento-inner, 16px);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .swatch-widget__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .swatch-widget__title {
    font-family: var(--font-display, sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f4f4f5;
  }

  .swatch-widget__spec {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    color: #a1a1aa;
  }

  .swatch-widget__counters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .token-box {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-subtle, 6px);
    padding: 0.55rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .token-box__val {
    font-family: var(--font-display, sans-serif);
    font-size: 1.1rem;
    font-weight: 700;
    color: #f4f4f5;
  }

  .token-box__lbl {
    font-family: var(--font-mono, monospace);
    font-size: 0.64rem;
    color: #a1a1aa;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .swatch-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4rem;
    height: 36px;
  }

  .swatch-chip {
    border-radius: var(--radius-subtle, 6px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.2rem;
    overflow: hidden;
  }

  .swatch-chip__label {
    font-family: var(--font-mono, monospace);
    font-size: 0.54rem;
    background: rgba(8, 3, 3, 0.85);
    color: #f4f4f5;
    padding: 0.05rem 0.25rem;
    border-radius: 3px;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .swatch-chip,
    .swatch-chip__label {
      transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), opacity 180ms ease;
    }

    .swatch-chip:hover {
      transform: translateY(-2px);
      z-index: 2;
    }

    .swatch-chip:hover .swatch-chip__label {
      opacity: 1;
    }
  }

  .swatch-widget__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .token-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    font-weight: 600;
    background: var(--color-accent, #ee2626);
    color: #080303;
    border-radius: var(--radius-pill, 9999px);
    padding: 0.2rem 0.6rem;
  }

  .token-sync {
    font-family: var(--font-mono, monospace);
    font-size: 0.64rem;
    color: #a1a1aa;
  }

  :global(html[data-era='1984']) .swatch-widget,
  :global(html[data-era='1984']) .token-box,
  :global(html[data-era='1984']) .swatch-chip,
  :global(html[data-era='1984']) .token-pill {
    border-radius: 0 !important;
  }

  :global(html[data-era='1984']) .swatch-widget {
    background: #000000;
    border-color: #ee2626;
  }
</style>
