---
export interface ConnectionNode {
  badge: string;
  title: string;
  subtitle: string;
  variant: 'crimson' | 'obsidian';
}

interface Props {
  headerLabel?: string;
  nodes?: [ConnectionNode, ConnectionNode];
}

const {
  headerLabel = 'Your next connection',
  nodes = [
    {
      badge: 'CONTEXT_MATCH // 94%',
      title: 'Explainable AI Narrative',
      subtitle: 'Transparent rationale surfaced directly inside the user decision flow.',
      variant: 'crimson',
    },
    {
      badge: 'LOCAL_INFERENCE // ON-DEVICE',
      title: 'Zero-Leakage Telemetry',
      subtitle: 'Adaptive persona matching without external data exposure.',
      variant: 'obsidian',
    },
  ],
} = Astro.props;
---

<div class="dual-widget" role="region" aria-label={headerLabel}>
  <div class="dual-widget__top">
    <span class="dual-widget__title">{headerLabel}</span>
    <span class="dual-widget__tag">ACUX // AI-ENGINE</span>
  </div>

  <div class="dual-widget__grid">
    {nodes.map((node) => (
      <div class:list={['conn-node', `conn-node--${node.variant}`]}>
        <span class="conn-node__badge">{node.badge}</span>
        <strong class="conn-node__title">{node.title}</strong>
        <p class="conn-node__sub">{node.subtitle}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .dual-widget {
    background: rgba(10, 6, 8, 0.9);
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento-inner, 16px);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .dual-widget__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .dual-widget__title {
    font-family: var(--font-display, sans-serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #f4f4f5;
  }

  .dual-widget__tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    color: #a1a1aa;
  }

  .dual-widget__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  @media (max-width: 480px) {
    .dual-widget__grid {
      grid-template-columns: 1fr;
    }
  }

  .conn-node {
    border-radius: var(--radius-subtle, 6px);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .conn-node--crimson {
    background: linear-gradient(155deg, rgba(66, 12, 20, 0.88) 0%, rgba(28, 6, 10, 0.95) 100%);
    border: 1px solid rgba(238, 38, 38, 0.48);
  }

  .conn-node--obsidian {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
  }

  @media (prefers-reduced-motion: no-preference) {
    .conn-node {
      transition: border-color 200ms ease, transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .conn-node:hover {
      border-color: var(--color-accent, #ee2626);
      transform: translateY(-2px);
    }
  }

  .conn-node__badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.62rem;
    color: var(--color-accent, #ee2626);
    letter-spacing: 0.05em;
  }

  .conn-node__title {
    font-family: var(--font-display, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    color: #f4f4f5;
    line-height: 1.25;
  }

  .conn-node__sub {
    font-family: var(--font-body, sans-serif);
    font-size: 0.76rem;
    line-height: 1.45;
    color: #d4d4d8;
    margin: 0;
  }

  :global(html[data-era='1984']) .dual-widget,
  :global(html[data-era='1984']) .conn-node {
    border-radius: 0 !important;
    background: #000000 !important;
    border-color: #ee2626 !important;
  }
</style>
