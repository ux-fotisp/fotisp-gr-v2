---
// CosmicPolygonMotif.astro — EDGE Design System Abstract Cosmic Polygonal Vector
// Renders faceted crimson/obsidian geometric planes, constellation nodes, and telemetry lines.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['edge-cosmic-motif', className]} aria-hidden="true">
  <svg
    viewBox="0 0 600 600"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="edge-cosmic-motif__svg"
  >
    <defs>
      <!-- Crimson Radial Atmosphere Glow -->
      <radialGradient id="edge-cosmic-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#EE2626" stop-opacity="0.24" />
        <stop offset="50%" stop-color="#EE2626" stop-opacity="0.06" />
        <stop offset="100%" stop-color="#080303" stop-opacity="0" />
      </radialGradient>
      <!-- 1-Bit Dither Dot Pattern -->
      <pattern id="edge-cosmic-dots" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1" fill="#EE2626" fill-opacity="0.3" />
      </pattern>
    </defs>

    <!-- Ambient Core Glow -->
    <circle cx="300" cy="300" r="280" fill="url(#edge-cosmic-glow)" />

    <!-- 1-Bit Dot Fill in central diamond -->
    <polygon points="300,60 480,240 300,520 120,240" fill="url(#edge-cosmic-dots)" opacity="0.45" />

    <!-- Outer Faceted Hexagon Mesh -->
    <polygon
      points="300,40 520,160 520,440 300,560 80,440 80,160"
      stroke="var(--color-accent)"
      stroke-opacity="0.25"
      stroke-width="1"
      stroke-dasharray="4 4"
    />

    <!-- Intersecting Primary Polygonal Planes -->
    <polygon
      points="300,60 480,240 300,320"
      fill="#EE2626"
      fill-opacity="0.08"
      stroke="var(--color-accent)"
      stroke-opacity="0.45"
      stroke-width="1.2"
    />
    <polygon
      points="120,240 300,60 300,320"
      fill="#EE2626"
      fill-opacity="0.04"
      stroke="var(--color-accent)"
      stroke-opacity="0.4"
      stroke-width="1.2"
    />
    <polygon
      points="300,320 480,240 380,460"
      fill="#EE2626"
      fill-opacity="0.12"
      stroke="var(--color-accent)"
      stroke-opacity="0.5"
      stroke-width="1.2"
    />
    <polygon
      points="300,320 380,460 300,520"
      fill="#EE2626"
      fill-opacity="0.06"
      stroke="var(--color-accent)"
      stroke-opacity="0.4"
      stroke-width="1.2"
    />
    <polygon
      points="300,320 300,520 220,460"
      fill="#EE2626"
      fill-opacity="0.1"
      stroke="var(--color-accent)"
      stroke-opacity="0.45"
      stroke-width="1.2"
    />
    <polygon
      points="120,240 300,320 220,460"
      fill="#EE2626"
      fill-opacity="0.05"
      stroke="var(--color-accent)"
      stroke-opacity="0.35"
      stroke-width="1.2"
    />

    <!-- Central Floating Diamond Facet -->
    <polygon
      points="300,180 370,280 300,380 230,280"
      fill="#080303"
      fill-opacity="0.85"
      stroke="var(--color-accent)"
      stroke-opacity="0.8"
      stroke-width="1.5"
    />

    <!-- Diagonal Ray Telemetry Axes -->
    <line x1="80" y1="160" x2="520" y2="440" stroke="var(--color-accent)" stroke-opacity="0.2" stroke-width="0.75" />
    <line x1="80" y1="440" x2="520" y2="160" stroke="var(--color-accent)" stroke-opacity="0.2" stroke-width="0.75" />
    <line x1="300" y1="20" x2="300" y2="580" stroke="var(--color-accent)" stroke-opacity="0.25" stroke-width="0.75" stroke-dasharray="2 3" />
    <line x1="20" y1="300" x2="580" y2="300" stroke="var(--color-accent)" stroke-opacity="0.25" stroke-width="0.75" stroke-dasharray="2 3" />

    <!-- Constellation Vertices / Nodes -->
    <circle cx="300" cy="60" r="3" fill="var(--color-accent)" />
    <circle cx="480" cy="240" r="3" fill="var(--color-accent)" />
    <circle cx="380" cy="460" r="3" fill="var(--color-accent)" />
    <circle cx="300" cy="520" r="3" fill="var(--color-accent)" />
    <circle cx="220" cy="460" r="3" fill="var(--color-accent)" />
    <circle cx="120" cy="240" r="3" fill="var(--color-accent)" />
    <circle cx="300" cy="320" r="4" fill="var(--color-text)" stroke="var(--color-accent)" stroke-width="1.5" />

    <!-- Coordinates Markers -->
    <text x="312" y="65" font-family="monospace" font-size="8" fill="var(--color-accent)" opacity="0.7">[EDGE_NODE_01]</text>
    <text x="492" y="244" font-family="monospace" font-size="8" fill="var(--color-accent)" opacity="0.7">[ORBIT_X:0.78]</text>
    <text x="130" y="235" font-family="monospace" font-size="8" fill="var(--color-accent)" opacity="0.7">[ORBIT_X:0.12]</text>
    <text x="312" y="525" font-family="monospace" font-size="8" fill="var(--color-accent)" opacity="0.7">[POLYGONAL_ROOT]</text>
  </svg>
</div>

<style>
  .edge-cosmic-motif {
    position: absolute;
    width: 680px;
    height: 680px;
    top: 50%;
    right: -60px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 0;
    opacity: 0.7;
    mix-blend-mode: screen;
  }

  .edge-cosmic-motif__svg {
    width: 100%;
    height: 100%;
    animation: cosmic-drift 24s ease-in-out infinite alternate;
  }

  @keyframes cosmic-drift {
    0% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.03) rotate(1.5deg); }
    100% { transform: scale(0.98) rotate(-1.5deg); }
  }

  @media (max-width: 900px) {
    .edge-cosmic-motif {
      width: 420px;
      height: 420px;
      right: -120px;
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .edge-cosmic-motif__svg {
      animation: none;
    }
  }
</style>
