---
// src/components/CaseStudyDiagram.astro
// Theme-Reactive SVG Technical Architectural Schematics
// Clean vector line-work using currentColor, var(--color-accent), and var(--border-1bit)
// Automatically inverts under html[data-era="1984"]

interface Props {
  id: string; // 'medipulse' | 'aethra' | 'healthpulse' | 'food-we-love'
  title?: string;
  figureTag?: string;
  class?: string;
}

const {
  id,
  title = 'System Architecture Schematic',
  figureTag = 'Diag. 01',
  class: className = '',
} = Astro.props;

const slug = id.replace(/\.mdx?$/, '');
---

<figure class:list={['cs-diagram u-window u-border-1bit', className]} aria-label={`${title} (${figureTag})`}>
  <div class="cs-diagram__titlebar u-window-titlebar">
    <div class="cs-diagram__controls" aria-hidden="true">
      <span class="cs-diagram__btn cs-diagram__btn--close"></span>
      <span class="cs-diagram__btn cs-diagram__btn--min"></span>
    </div>
    <span class="cs-diagram__title u-mono u-text-xs u-truncate">
      schematic_{slug}.svg · 800×400 CAD_SPEC
    </span>
    <span class="cs-diagram__tag u-mono u-text-xs u-text-accent">
      {figureTag}
    </span>
  </div>

  <div class="cs-diagram__canvas-wrap">
    {slug === 'medipulse' && (
      <!-- MEDIPULSE: Dual-Viewport Clinical Reading & 800ms Debounce Pipeline -->
      <svg viewBox="0 0 800 400" class="cs-diagram__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="MediPulse Clinical Reading Architecture">
        <defs>
          <pattern id="grid-pattern-mp" width="20" height="20" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="20" y2="0" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
            <line x1="0" y1="0" x2="0" y2="20" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="800" height="400" fill="url(#grid-pattern-mp)" />

        <!-- Subsystem A: Mobile Hospital Floor (56px Thumb-Zone) -->
        <g class="diag-group">
          <rect x="30" y="40" width="340" height="320" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
          <text x="45" y="65" font-family="monospace" font-size="11" fill="currentColor" opacity="0.6">SUBSYSTEM 01: MOBILE FLOOR ENVIRONMENT</text>

          <!-- Phone Outline -->
          <rect x="60" y="85" width="130" height="250" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
          <line x1="60" y1="120" x2="190" y2="120" stroke="currentColor" stroke-width="1" />
          <text x="75" y="108" font-family="monospace" font-size="9" fill="currentColor">CLINICAL DOC</text>

          <!-- Document lines -->
          <line x1="75" y1="140" x2="175" y2="140" stroke="currentColor" stroke-width="1" opacity="0.3" />
          <line x1="75" y1="155" x2="160" y2="155" stroke="currentColor" stroke-width="1" opacity="0.3" />
          <line x1="75" y1="170" x2="170" y2="170" stroke="currentColor" stroke-width="1" opacity="0.3" />
          <line x1="75" y1="185" x2="140" y2="185" stroke="currentColor" stroke-width="1" opacity="0.3" />

          <!-- 56px Touch-Bar Zone -->
          <rect x="60" y="279" width="130" height="56" fill="var(--color-accent)" fill-opacity="0.15" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x="72" y="302" font-family="monospace" font-size="9" font-weight="bold" fill="var(--color-accent)">56px TOUCH-BAR</text>
          <text x="70" y="318" font-family="monospace" font-size="8" fill="currentColor">[SCAN][READ][FILT]</text>

          <!-- Annotations -->
          <line x1="190" y1="307" x2="230" y2="307" stroke="var(--color-accent)" stroke-width="1.5" />
          <circle cx="230" cy="307" r="3" fill="var(--color-accent)" />
          <text x="240" y="304" font-family="monospace" font-size="9" fill="var(--color-accent)" font-weight="bold">GLOVE POSTURE ZONE</text>
          <text x="240" y="318" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">68% single-handed use</text>
        </g>

        <!-- Pipeline: 800ms Debounce Queue -->
        <g class="diag-group">
          <!-- Flow arrow from touch to queue -->
          <path d="M 370 170 L 430 170" fill="none" stroke="currentColor" stroke-width="1.5" marker-end="url(#arrow)" />
          <rect x="430" y="110" width="130" height="120" fill="none" stroke="currentColor" stroke-width="1.5" />
          <text x="445" y="135" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor">800ms DEBOUNCE</text>
          <text x="445" y="152" font-family="monospace" font-size="9" fill="var(--color-accent)">PIPELINE QUEUE</text>

          <rect x="445" y="170" width="100" height="16" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="1" />
          <text x="452" y="182" font-family="monospace" font-size="8" fill="currentColor">ANNOTATION_EVT</text>
          <text x="445" y="210" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Zero data loss</text>
          <text x="445" y="222" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">on floor interrupt</text>
        </g>

        <!-- Subsystem B: Desktop High-Density Console -->
        <g class="diag-group">
          <rect x="590" y="40" width="180" height="320" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
          <text x="605" y="65" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">DESKTOP CONSOLE</text>

          <!-- High-density 32px filter grid -->
          <rect x="605" y="85" width="150" height="32" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="615" y="105" font-family="monospace" font-size="8" fill="currentColor">ROW 01 · 32px DENSITY</text>

          <rect x="605" y="125" width="150" height="32" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="615" y="145" font-family="monospace" font-size="8" fill="currentColor">ROW 02 · 32px DENSITY</text>

          <rect x="605" y="165" width="150" height="32" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="615" y="185" font-family="monospace" font-size="8" fill="currentColor">ROW 03 · 32px DENSITY</text>

          <path d="M 560 170 L 605 170" fill="none" stroke="currentColor" stroke-width="1.5" />
          <text x="605" y="230" font-family="monospace" font-size="9" fill="var(--color-accent)">STATE SYNC</text>
          <text x="605" y="246" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Shared Token Model</text>
          <text x="605" y="260" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">SUS Score: 82 / 100</text>
        </g>
      </svg>
    )}

    {slug === 'aethra' && (
      <!-- AETHRA: Open EU Civic Telemetry Ingestion -> AI Synthesis -> CityOps -->
      <svg viewBox="0 0 800 400" class="cs-diagram__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="AETHRA CityOps Ingestion and AI Synthesis Architecture">
        <defs>
          <pattern id="grid-pattern-ae" width="20" height="20" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="20" y2="0" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
            <line x1="0" y1="0" x2="0" y2="20" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="800" height="400" fill="url(#grid-pattern-ae)" />

        <!-- Node 1: Multi-Source EU Telemetry Ingestion -->
        <g class="diag-group">
          <rect x="30" y="40" width="210" height="320" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
          <text x="45" y="65" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">INGESTION LAYER</text>

          <rect x="45" y="85" width="180" height="45" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="55" y="105" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">COPERNICUS EMS</text>
          <text x="55" y="120" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Satellite & flood telemetry</text>

          <rect x="45" y="145" width="180" height="45" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="55" y="165" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">OPEN DATA PORTAL</text>
          <text x="55" y="180" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">11 EU APIs reconciled</text>

          <rect x="45" y="205" width="180" height="45" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="55" y="225" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">MUNICIPAL SENSORS</text>
          <text x="55" y="240" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Real-time incident stream</text>

          <line x1="135" y1="250" x2="135" y2="290" stroke="currentColor" stroke-width="1.5" />
          <circle cx="135" cy="290" r="3" fill="var(--color-accent)" />
          <text x="65" y="315" font-family="monospace" font-size="8" fill="var(--color-accent)">SCHEMA NORMALISATION</text>
        </g>

        <!-- Pipeline Bus -->
        <path d="M 240 180 L 300 180" fill="none" stroke="currentColor" stroke-width="1.5" />

        <!-- Node 2: AI Narrative Synthesis Engine -->
        <g class="diag-group">
          <rect x="300" y="80" width="190" height="240" fill="var(--color-surface-sunken)" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x="315" y="110" font-family="monospace" font-size="11" font-weight="bold" fill="var(--color-accent)">AI NARRATIVE SYNTHESIS</text>
          <line x1="315" y1="125" x2="475" y2="125" stroke="var(--color-accent)" stroke-width="1" />

          <text x="315" y="150" font-family="monospace" font-size="9" fill="currentColor">1. Incident Clustering</text>
          <text x="315" y="175" font-family="monospace" font-size="9" fill="currentColor">2. Semantic Deduplication</text>
          <text x="315" y="200" font-family="monospace" font-size="9" fill="currentColor">3. Citation Grounding</text>

          <rect x="315" y="225" width="160" height="45" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="325" y="245" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">TRUST COEFFICIENT</text>
          <text x="325" y="260" font-family="monospace" font-size="8" fill="var(--color-accent)">4.1 / 5 with citations</text>
          <text x="325" y="272" font-family="monospace" font-size="8" fill="currentColor" opacity="0.5">vs 2.3/5 without</text>
        </g>

        <!-- Pipeline Bus to Console -->
        <path d="M 490 180 L 550 180" fill="none" stroke="currentColor" stroke-width="1.5" />

        <!-- Node 3: CityOps Operator Console -->
        <g class="diag-group">
          <rect x="550" y="40" width="220" height="320" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" />
          <text x="565" y="65" font-family="monospace" font-size="10" fill="currentColor" opacity="0.6">OPERATOR CONSOLE</text>

          <!-- Left incident rail -->
          <rect x="565" y="85" width="55" height="180" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="570" y="105" font-family="monospace" font-size="7" fill="currentColor">INCIDENTS</text>
          <line x1="570" y1="120" x2="610" y2="120" stroke="var(--color-accent)" stroke-width="2" />
          <line x1="570" y1="135" x2="610" y2="135" stroke="currentColor" stroke-width="1" opacity="0.4" />
          <line x1="570" y1="150" x2="610" y2="150" stroke="currentColor" stroke-width="1" opacity="0.4" />

          <!-- Map layer -->
          <rect x="625" y="85" width="135" height="100" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="635" y="105" font-family="monospace" font-size="8" fill="currentColor">GIS MAP LAYER</text>
          <circle cx="680" cy="140" r="12" fill="none" stroke="var(--color-accent)" stroke-width="1.5" stroke-dasharray="2 2" />
          <circle cx="680" cy="140" r="3" fill="var(--color-accent)" />

          <!-- AI Briefing panel -->
          <rect x="625" y="195" width="135" height="70" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="635" y="215" font-family="monospace" font-size="8" font-weight="bold" fill="currentColor">AI SITUATION BRIEF</text>
          <text x="635" y="235" font-family="monospace" font-size="7" fill="currentColor" opacity="0.7">3 min gen (vs 22m manual)</text>
          <text x="635" y="250" font-family="monospace" font-size="7" fill="currentColor" opacity="0.7">87% accuracy (vs 61%)</text>

          <text x="565" y="300" font-family="monospace" font-size="9" fill="currentColor" font-weight="bold">HORIZON EUROPE AUDITED</text>
          <text x="565" y="315" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Presented to Greek Municipalities</text>
        </g>
      </svg>
    )}

    {slug === 'healthpulse' && (
      <!-- HEALTHPULSE: Dual-Condition Biometric State Machine -->
      <svg viewBox="0 0 800 400" class="cs-diagram__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="HealthPulse Biometric State Machine">
        <defs>
          <pattern id="grid-pattern-hp" width="20" height="20" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="20" y2="0" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
            <line x1="0" y1="0" x2="0" y2="20" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="800" height="400" fill="url(#grid-pattern-hp)" />

        <!-- State 1: Ingestion -->
        <g class="diag-group">
          <rect x="40" y="110" width="180" height="180" fill="none" stroke="currentColor" stroke-width="1.5" />
          <text x="55" y="135" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor">STATE 01: INGESTION</text>
          <line x1="55" y1="145" x2="205" y2="145" stroke="currentColor" stroke-width="1" opacity="0.4" />

          <text x="55" y="170" font-family="monospace" font-size="9" fill="currentColor">Dual Biometrics:</text>
          <rect x="55" y="185" width="150" height="26" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" />
          <text x="65" y="202" font-family="monospace" font-size="8" fill="currentColor">BP: Systolic / Diastolic</text>

          <rect x="55" y="220" width="150" height="26" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" />
          <text x="65" y="237" font-family="monospace" font-size="8" fill="currentColor">GLUCOSE: mg/dL Context</text>

          <text x="55" y="270" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Single-tap gestural entry</text>
        </g>

        <!-- Transition Vector 1 -->
        <path d="M 220 200 L 300 200" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="232" y="190" font-family="monospace" font-size="8" fill="var(--color-accent)">DELTA CHECK</text>

        <!-- State 2: Calm Tech Evaluation Gate -->
        <g class="diag-group">
          <polygon points="390,110 480,200 390,290 300,200" fill="var(--color-surface-sunken)" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x="350" y="195" font-family="monospace" font-size="9" font-weight="bold" fill="var(--color-accent)">PROGRESSIVE</text>
          <text x="350" y="210" font-family="monospace" font-size="9" font-weight="bold" fill="var(--color-accent)">DISCLOSURE</text>
          <text x="350" y="225" font-family="monospace" font-size="8" fill="currentColor">THRESHOLD</text>
        </g>

        <!-- Branch A: Non-Alarming Trend -->
        <path d="M 390 110 L 390 60 L 560 60" fill="none" stroke="currentColor" stroke-width="1.5" />
        <text x="410" y="80" font-family="monospace" font-size="8" fill="currentColor">Within personal baseline</text>

        <!-- Branch B: Clinical Deviation -->
        <path d="M 480 200 L 560 200" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
        <text x="490" y="190" font-family="monospace" font-size="8" fill="var(--color-accent)">Deviation detected</text>

        <!-- State 3: Output State Node -->
        <g class="diag-group">
          <rect x="560" y="40" width="200" height="110" fill="none" stroke="currentColor" stroke-width="1.5" />
          <text x="575" y="65" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">BASELINE CONFIRMATION</text>
          <text x="575" y="85" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Suppresses alarm fatigue</text>
          <text x="575" y="100" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Encourages daily cadence</text>
          <text x="575" y="125" font-family="monospace" font-size="8" fill="currentColor" font-weight="bold">WCAG AAA Contrast Standard</text>
        </g>

        <g class="diag-group">
          <rect x="560" y="170" width="200" height="150" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x="575" y="195" font-family="monospace" font-size="9" font-weight="bold" fill="var(--color-accent)">CLINICAL EXPORT SPEC</text>
          <text x="575" y="215" font-family="monospace" font-size="8" fill="currentColor" opacity="0.8">Physician-ready summary</text>
          <text x="575" y="230" font-family="monospace" font-size="8" fill="currentColor" opacity="0.8">Hellenic Diabetes Assoc. ref</text>
          <rect x="575" y="250" width="170" height="40" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" />
          <text x="585" y="270" font-family="monospace" font-size="8" fill="currentColor">SUS BENCHMARK: 84 / 100</text>
          <text x="585" y="282" font-family="monospace" font-size="7" fill="var(--color-accent)">Industry benchmark: 68</text>
        </g>
      </svg>
    )}

    {slug === 'food-we-love' && (
      <!-- FOODWELOVE: Faceted Organic Taxonomy & Provenance Verification Graph -->
      <svg viewBox="0 0 800 400" class="cs-diagram__svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="FoodWeLove Organic Taxonomy and Provenance Verification Graph">
        <defs>
          <pattern id="grid-pattern-fw" width="20" height="20" patternUnits="userSpaceOnUse">
            <line x1="0" y1="0" x2="20" y2="0" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
            <line x1="0" y1="0" x2="0" y2="20" stroke="currentColor" stroke-opacity="0.07" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="800" height="400" fill="url(#grid-pattern-fw)" />

        <!-- Node 1: Unstructured Catalogue -->
        <g class="diag-group">
          <rect x="30" y="130" width="160" height="140" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
          <text x="45" y="155" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor">1,400+ SKU CATALOGUE</text>
          <text x="45" y="175" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Raw Supplier Taxonomy</text>
          <text x="45" y="195" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Buried Certification</text>
          <text x="45" y="215" font-family="monospace" font-size="8" fill="currentColor" opacity="0.6">Cart Friction Drop-off</text>
          <text x="45" y="245" font-family="monospace" font-size="8" fill="var(--color-accent)">[LEGACY ARCHITECTURE]</text>
        </g>

        <!-- Pipeline Arrow -->
        <path d="M 190 200 L 260 200" fill="none" stroke="currentColor" stroke-width="1.5" />

        <!-- Node 2: Faceted Occasion-Based Taxonomy Matrix -->
        <g class="diag-group">
          <rect x="260" y="60" width="240" height="280" fill="var(--color-surface-sunken)" stroke="currentColor" stroke-width="1.5" />
          <text x="275" y="90" font-family="monospace" font-size="11" font-weight="bold" fill="currentColor">FACETED IA ENGINE</text>
          <line x1="275" y1="105" x2="485" y2="105" stroke="currentColor" stroke-width="1" opacity="0.3" />

          <!-- Facet 1 -->
          <rect x="275" y="120" width="210" height="40" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="285" y="138" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">FACET: OCCASION DISCOVERY</text>
          <text x="285" y="152" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Breakfast · Dinner Party · Gifting</text>

          <!-- Facet 2 -->
          <rect x="275" y="175" width="210" height="40" fill="none" stroke="var(--color-accent)" stroke-width="1" />
          <text x="285" y="193" font-family="monospace" font-size="9" font-weight="bold" fill="var(--color-accent)">PROVENANCE VERIFICATION</text>
          <text x="285" y="207" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Certified Organic Lot Traceability</text>

          <!-- Facet 3 -->
          <rect x="275" y="230" width="210" height="40" fill="none" stroke="currentColor" stroke-width="1" />
          <text x="285" y="248" font-family="monospace" font-size="9" font-weight="bold" fill="currentColor">DIETARY FILTER MATRIX</text>
          <text x="285" y="262" font-family="monospace" font-size="8" fill="currentColor" opacity="0.7">Vegan · Raw · Single-Estate</text>

          <text x="275" y="310" font-family="monospace" font-size="8" fill="var(--color-accent)">ADOPTED BY 3 PARENT PROPERTIES</text>
        </g>

        <!-- Pipeline Arrow -->
        <path d="M 500 200 L 570 200" fill="none" stroke="currentColor" stroke-width="1.5" />

        <!-- Node 3: Frictionless 3-Step Checkout Flow -->
        <g class="diag-group">
          <rect x="570" y="90" width="200" height="220" fill="none" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x="585" y="115" font-family="monospace" font-size="10" font-weight="bold" fill="var(--color-accent)">FRICTIONLESS CHECKOUT</text>
          <line x1="585" y1="125" x2="755" y2="125" stroke="var(--color-accent)" stroke-width="1" opacity="0.3" />

          <!-- Step 1 -->
          <rect x="585" y="140" width="170" height="30" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" />
          <text x="595" y="160" font-family="monospace" font-size="8" fill="currentColor">01. Basket & Provenance Review</text>

          <!-- Step 2 -->
          <rect x="585" y="180" width="170" height="30" fill="currentColor" fill-opacity="0.05" stroke="currentColor" stroke-width="1" />
          <text x="595" y="200" font-family="monospace" font-size="8" fill="currentColor">02. Streamlined Delivery Spec</text>

          <!-- Step 3 -->
