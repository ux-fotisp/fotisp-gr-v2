---
// DesktopWindow.astro
// 1-bit OS window wrapper with titlebar controls,
// file badge, figure tag, live coordinates, and DraggableFrame React 19 island.
// Defaults to edge-to-edge content bleed (p-0) inside 1px crimson border;
// optional `padded` prop restores internal padding for text-heavy windows.
import DraggableFrame from './DraggableFrame';

interface Props {
  title: string;
  fileBadge?: string;         // e.g. "medipulse.mdx" or "acux_taxonomy.bib"
  figureTag?: string;         // e.g. "Fig. 01"
  coordX?: number;            // 0.00 – 1.00
  coordY?: number;            // 0.00 – 1.00
  class?: string;
  padded?: boolean;           // restore internal padding for text-heavy windows
  noPadding?: boolean;        // backwards compatibility (deprecated in favor of default p-0)
  scrollable?: boolean;
}

const {
  title,
  fileBadge,
  figureTag = 'Fig. 00',
  coordX = 0.00,
  coordY = 0.00,
  class: className,
  padded = false,
  noPadding,
  scrollable = false,
} = Astro.props;

// Format coordinate display
const fmtCoord = (n: number) => n.toFixed(2);

// Default is p-0 for edge-to-edge bleed; padded=true restores internal padding
const hasPadding = padded || (noPadding === false);
---

<DraggableFrame client:idle className={className}>
  <div class:list={['desktop-window', 'u-window']}>
    <!-- Titlebar (Specific drag handle) -->
    <div class="desktop-window__titlebar u-window-titlebar" role="heading" aria-level={3}>
      <!-- Window controls (decorative — 1-bit squares) -->
      <div class="desktop-window__controls" aria-hidden="true">
        <span class="desktop-window__btn desktop-window__btn--close" title="Close"></span>
        <span class="desktop-window__btn desktop-window__btn--min" title="Minimise"></span>
      </div>

      <!-- Window title -->
      <span class="desktop-window__title u-mono u-text-xs u-truncate">
        {title}
      </span>

      <!-- File badge -->
      {fileBadge && (
        <span class="desktop-window__badge u-mono u-text-xs" aria-label={`File: ${fileBadge}`}>
          {fileBadge}
        </span>
      )}
    </div>

    <!-- Window body / content: default p-0 for edge-to-edge bleed -->
    <div
      class:list={[
        'desktop-window__body',
        'window-content',
        hasPadding ? 'desktop-window__body--padded window-content--padded' : 'p-0',
        scrollable && 'desktop-window__body--scroll',
      ]}
    >
      <slot />
    </div>

    <!-- Coordinate bar -->
    <div class="desktop-window__coords" aria-label={`${figureTag}, coordinates x:${fmtCoord(coordX)} y:${fmtCoord(coordY)}`}>
      <span class="u-mono u-text-xs u-text-faint">{figureTag}</span>
      <span class="u-mono u-text-xs u-text-faint desktop-window__coords-sep" aria-hidden="true">·</span>
      <span
        class="u-mono u-text-xs u-text-faint desktop-window__coords-val"
        data-default-coords={`x: ${fmtCoord(coordX)} y: ${fmtCoord(coordY)}`}
      >
        x: {fmtCoord(coordX)} y: {fmtCoord(coordY)}
      </span>
    </div>
  </div>
</DraggableFrame>

<script>
  function setupLiveCoords() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const windows = document.querySelectorAll<HTMLElement>('.desktop-window');
    windows.forEach((win) => {
      if (win.dataset.coordsLive === 'true') return;
      win.dataset.coordsLive = 'true';

      const readOut = win.querySelector<HTMLElement>('.desktop-window__coords-val');
      if (!readOut) return;

      const fallbackText = readOut.dataset.defaultCoords || readOut.textContent || '';
      let isTicking = false;

      win.addEventListener('pointermove', (e: PointerEvent) => {
        if (isTicking) return;
        isTicking = true;

        requestAnimationFrame(() => {
          const rect = win.getBoundingClientRect();
          if (rect.width > 0 && rect.height > 0) {
            const relX = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
            const relY = Math.max(0, Math.min(1, (e.clientY - rect.top) / rect.height));
            readOut.textContent = `x: ${relX.toFixed(2)} y: ${relY.toFixed(2)}`;
          }
          isTicking = false;
        });
      }, { passive: true });

      win.addEventListener('pointerleave', () => {
        readOut.textContent = fallbackText;
      }, { passive: true });
    });
  }

  // Run on initial load and on Astro view transition navigations
  setupLiveCoords();
  document.addEventListener('astro:page-load', setupLiveCoords);
</script>

<style>
  :global(.draggable-frame) {
    width: 100%;
    display: block;
  }

  .desktop-window {
    display: flex;
    flex-direction: column;
    min-width: var(--window-min-width);
    background-color: var(--color-surface);
    border: var(--border-1bit);
    border-radius: var(--radius-card);
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  /* Titlebar */
  .desktop-window__titlebar {
    gap: var(--space-2);
    min-height: var(--window-titlebar);
    flex-shrink: 0;
    border-bottom: var(--border-1bit);
    background-color: var(--color-chrome-bg);
  }

  /* Window control squares */
  .desktop-window__controls {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }

  .desktop-window__btn {
    display: block;
    width: 10px;
    height: 10px;
    border: var(--border-1bit);
    flex-shrink: 0;
    cursor: default;
  }

  .desktop-window__btn--close:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .desktop-window__btn--min:hover {
    background-color: var(--color-text-muted);
    border-color: var(--color-text-muted);
  }

  /* Title */
  .desktop-window__title {
    flex: 1;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  /* File badge */
  .desktop-window__badge {
    flex-shrink: 0;
    padding: 2px var(--space-2);
    border: var(--border-1bit-subtle);
    color: var(--color-text-faint);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }

  /* Body / window-content: zero padding by default for edge-to-edge imagery bleed */
  .desktop-window__body,
  .window-content {
    flex: 1;
    min-height: 0;
    padding: 0;
    position: relative;
  }

  .desktop-window__body--padded,
  .window-content--padded {
    padding: var(--space-6);
  }

  .desktop-window__body--scroll {
    overflow-y: auto;
    max-height: 60vh;
  }

  /* Coordinate bar */
  .desktop-window__coords {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-top: var(--border-1bit);
    background-color: var(--color-chrome-bg);
  }

  .desktop-window__coords-sep {
    opacity: 0.4;
  }
</style>
