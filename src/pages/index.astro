---
// src/pages/index.astro
// Stage 12: Executive Positioning & 6-Section Asymmetric Bento Architecture
import BaseLayout from '../layouts/BaseLayout.astro';
import EdgeLottie from '../components/EdgeLottie';
import KpiChartPreview from '../components/bento/KpiChartPreview.astro';
import EditorialPrinciplesCard from '../components/bento/EditorialPrinciplesCard.astro';
import DualConnectionPreview from '../components/bento/DualConnectionPreview.astro';
import TokenSwatchPreview from '../components/bento/TokenSwatchPreview.astro';
import { siteConfig } from '../config/site';
import { getCollection, type CollectionEntry } from 'astro:content';

const caseStudies = (
  await getCollection('caseStudies', (e: CollectionEntry<'caseStudies'>) => !e.data.isDraft)
).sort(
  (a: CollectionEntry<'caseStudies'>, b: CollectionEntry<'caseStudies'>) =>
    ((a.data as any).featuredOrder || (a.data as any).order || 99) -
    ((b.data as any).featuredOrder || (b.data as any).order || 99)
);

const publications = (
  await getCollection('publications', (e: CollectionEntry<'publications'>) => !e.data.isDraft)
).sort(
  (a: CollectionEntry<'publications'>, b: CollectionEntry<'publications'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Rich Schema.org ScholarlyArticle definitions
const scholarlySchemas = publications.map((pub: CollectionEntry<'publications'>) => ({
  '@type': 'ScholarlyArticle',
  headline: pub.data.title,
  name: pub.data.title,
  author: pub.data.authors.map((author: string) => ({
    '@type': 'Person',
    name: author,
  })),
  datePublished: pub.data.month ? `${pub.data.year}-${pub.data.month}` : `${pub.data.year}`,
  url: pub.data.url,
  sameAs: pub.data.doi ? `https://doi.org/${pub.data.doi}` : pub.data.url,
  ...(pub.data.abstract ? { description: pub.data.abstract } : {}),
}));

const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Fotios Pastrakis',
    alternateName: siteConfig.brand.author,
    url: siteConfig.brand.url,
    sameAs: [siteConfig.brand.social.linkedin, siteConfig.brand.social.github],
    jobTitle: 'Principal Front-End Systems Engineer & OOUX Architect',
    worksFor: {
      '@type': 'Organization',
      name: 'Pfizer / Deloitte',
    },
    knowsAbout: [
      'Object-Oriented UX',
      'Design Systems',
      'Clinical & Regulated UX',
      'Front-End Engineering',
      'Frontier & Local AI Architecture',
      'Information Architecture',
      'TypeScript',
      'Astro',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: siteConfig.brand.title,
    url: siteConfig.brand.url,
    description: siteConfig.hero.subheadline,
    author: { '@type': 'Person', name: siteConfig.brand.author },
    hasPart: caseStudies.map((cs: CollectionEntry<'caseStudies'>) => ({
      '@type': 'CreativeWork',
      name: cs.data.title,
      url: `${siteConfig.brand.url}/work/${cs.id.replace(/\.mdx?$/, '')}`,
    })),
  },
  ...scholarlySchemas,
];
---

<BaseLayout schema={indexSchema}>
  <div class="homepage" id="top">
    <!-- ── SECTION 1: 2-COLUMN HERO, ORBITAL RADAR HUD & AUTHORITY STRIP ── -->
    <section class="hero-section u-container" aria-labelledby="hero-title">
      <div class="hero-grid">
        {/* Left Column: Executive Copy */}
        <div class="hero-copy">
          <p class="hero-kicker">
            {siteConfig.hero.kicker}
          </p>

          <h1 id="hero-title" class="hero-h1">
            <span class="hero-h1__part1">{siteConfig.hero.headlinePart1}</span>
            <span class="hero-h1__part2">{siteConfig.hero.headlinePart2}</span>
          </h1>

          <p class="hero-body">
            {siteConfig.hero.subheadline}
          </p>

          <div class="hero-cta-row">
            <a href="#work" class="btn-hero-primary">
              See selected work <span class="arrow-right" aria-hidden="true">→</span>
            </a>
            <a href="#methodology" class="btn-hero-secondary">
              Explore approach <span class="arrow-down" aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        {/* Right Column: Orbital Radar HUD Bento Box */}
        <div class="hero-hud-bento">
          <div class="hud-bento__header">
            <div class="hud-bento__dot-title">
              <span class="hud-bento__dot" aria-hidden="true"></span>
              <span class="hud-bento__label">ORBITAL RADAR // LIVE</span>
            </div>
            <span class="hud-bento__coords">
              {siteConfig.brand.coordinates.lat}, {siteConfig.brand.coordinates.lng}
            </span>
          </div>

          <div class="hud-bento__canvas">
            <EdgeLottie
              client:visible
              height="260px"
              fallbackText={`[ RADAR HUD // ${siteConfig.brand.coordinates.label}: ${siteConfig.brand.coordinates.lat}, ${siteConfig.brand.coordinates.lng} ]`}
            />
          </div>

          <div class="hud-bento__footer">
            <span class="hud-bento__city">{siteConfig.brand.coordinates.label}</span>
            <span class="hud-bento__status">{siteConfig.availability.statusCompact}</span>
          </div>
        </div>
      </div>

      {/* 3-Column Authority Metric Strip */}
      <div class="hero-authority-strip" aria-label="Executive credentials & authority track">
        {siteConfig.hero.authorityMetrics.map((item) => (
          <div class="authority-tile">
            <span class="authority-tile__val">{item.value}</span>
            <div class="authority-tile__meta">
              <strong class="authority-tile__lbl">{item.label}</strong>
              <span class="authority-tile__ctx">{item.context}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ── SECTION 2: 12-COLUMN ASYMMETRIC BENTO GRID (#work) ───────── -->
    <section class="section-work u-container" id="work" aria-labelledby="work-title">
      <header class="section-header">
        <div class="section-header__text">
          <span class="section-kicker">{siteConfig.bento.sectionKicker}</span>
          <h2 id="work-title" class="section-title">{siteConfig.bento.sectionTitle}</h2>
        </div>

        {/* OOUX Domain / Filter Pills */}
        <div class="bento-filters" role="group" aria-label="Filter case studies by domain">
          <button type="button" class="filter-pill is-active" data-filter="all">All</button>
          <button type="button" class="filter-pill" data-filter="clinical">Clinical & HealthTech</button>
          <button type="button" class="filter-pill" data-filter="cityops">CityOps & AI</button>
          <button type="button" class="filter-pill" data-filter="ecommerce">E-Commerce</button>
        </div>
      </header>

      <div class="bento-grid-12">
        {/* Card 1 (8-Col Wide Desktop): MediPulse + KpiChartPreview */}
        <article class="bento-card bento-card--wide" data-domain="clinical">
          <div class="bento-card__preview">
            <KpiChartPreview />
          </div>
          <div class="bento-card__content">
            <span class="bento-card__kicker">{siteConfig.bento.cards.medipulse.kicker}</span>
            <h3 class="bento-card__title">{siteConfig.bento.cards.medipulse.title}</h3>
            <p class="bento-card__summary">{siteConfig.bento.cards.medipulse.summary}</p>
            <div class="bento-card__tags">
              <span class="bento-tag">[O:REF] Clinical Design Systems</span>
              <span class="bento-tag">[O:REF] Modular IA</span>
            </div>
            <a href="/work/medipulse" class="bento-card__link">
              <span>Inspect case study</span>
              <span class="arrow-right" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        {/* Card 2 (4-Col Tall Desktop): EditorialPrinciplesCard */}
        <div class="bento-card bento-card--tall" data-domain="clinical">
          <EditorialPrinciplesCard />
        </div>

        {/* Card 3 (6-Col Bottom Left): HealthPulse + DualConnectionPreview */}
        <article class="bento-card bento-card--half" data-domain="clinical">
          <div class="bento-card__preview">
            <DualConnectionPreview />
          </div>
          <div class="bento-card__content">
            <span class="bento-card__kicker">{siteConfig.bento.cards.healthpulse.kicker}</span>
            <h3 class="bento-card__title">{siteConfig.bento.cards.healthpulse.title}</h3>
            <p class="bento-card__summary">{siteConfig.bento.cards.healthpulse.summary}</p>
            <div class="bento-card__tags">
              <span class="bento-tag">[O:REF] Adaptive AI Recommenders</span>
              <span class="bento-tag">[O:REF] Behavioral Telemetry</span>
            </div>
            <a href="/work/healthpulse" class="bento-card__link">
              <span>Inspect case study</span>
              <span class="arrow-right" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        {/* Card 4 (6-Col Bottom Right): AETHRA + TokenSwatchPreview */}
        <article class="bento-card bento-card--half" data-domain="cityops">
          <div class="bento-card__preview">
            <TokenSwatchPreview />
          </div>
          <div class="bento-card__content">
            <span class="bento-card__kicker">{siteConfig.bento.cards.aethra.kicker}</span>
            <h3 class="bento-card__title">{siteConfig.bento.cards.aethra.title}</h3>
            <p class="bento-card__summary">{siteConfig.bento.cards.aethra.summary}</p>
            <div class="bento-card__tags">
              <span class="bento-tag">[O:REF] Token Governance</span>
              <span class="bento-tag">[O:REF] Atomic Contracts</span>
            </div>
            <a href="/work/aethra" class="bento-card__link">
              <span>Inspect case study</span>
              <span class="arrow-right" aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- ── SECTION 3: EMPIRICAL RIGOR & RESEARCH ROWS (#research) ──── -->
    <section class="section-research u-container" id="research" aria-labelledby="research-title">
      <header class="section-header">
        <div class="section-header__text">
          <span class="section-kicker">{siteConfig.research.sectionKicker}</span>
          <h2 id="research-title" class="section-title">{siteConfig.research.sectionTitle}</h2>
        </div>
        <a href="/about#publications" class="btn-all-writing">
          All writing <span aria-hidden="true">↗</span>
        </a>
      </header>

      <div class="research-table" role="region" aria-label="Peer-reviewed research and architecture publications">
        {siteConfig.research.rows.map((row) => (
          <article class="research-row">
            <div class="research-row__citation-col">
              <span class="research-citation-pill">{row.citation}</span>
              <span class="research-row__num">{row.number}</span>
            </div>

            <div class="research-row__body-col">
              <h3 class="research-row__title">{row.title}</h3>
              <p class="research-row__thesis">{row.thesis}</p>
            </div>

            <div class="research-row__action-col">
              {row.url ? (
                <a
                  href={row.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="research-action-link"
                  aria-label={`Read paper: ${row.title}`}
                >
                  <span class="research-action-link__text">Read paper</span>
                  <span class="arrow-right" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="research-preprint-badge">
                  [PREPRINT // LOCAL_FIRST]
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ── SECTION 4: 2-COLUMN STICKY PHILOSOPHY (#methodology) ────── -->
    <section class="section-methodology u-container" id="methodology" aria-labelledby="methodology-title">
      <div class="methodology-grid">
        {/* Left 5 Cols (Sticky on Desktop) */}
        <div class="methodology-left">
          <span class="section-kicker">{siteConfig.methodology.sectionKicker}</span>
          <h2 id="methodology-title" class="methodology-title">{siteConfig.methodology.sectionTitle}</h2>
          <p class="methodology-narrative">
            Great software systems don't happen by accident. By extracting the core domain objects before drawing screens, we decouple product logic from ephemeral UI layout and prevent high-cost engineering refactoring.
          </p>
        </div>

        {/* Right 7 Cols: 3 Methodology Pillars */}
        <div class="methodology-right">
          {siteConfig.methodology.pillars.map((pillar) => (
            <div class="methodology-pillar-card">
              <div class="pillar-node-badge" aria-hidden="true">
                <span class="pillar-node-dot"></span>
                <span class="pillar-node-step">{pillar.step}</span>
              </div>
              <div class="pillar-content">
                <h3 class="pillar-title">{pillar.title}</h3>
                <p class="pillar-description">{pillar.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── SECTION 5: BURGUNDY-CRIMSON EXECUTIVE BIO & CTA BANNER ──── -->
    <section class="section-bio u-container" aria-label="Executive introduction and advisory inquiry">
      <div class="executive-bio-banner">
        <div class="bio-banner__content">
          <span class="bio-banner__kicker">PRINCIPAL SYSTEMS & ADVISORY SCOPE</span>
          <h2 class="bio-banner__headline">
            {siteConfig.executiveBio.headline}
          </h2>
          <p class="bio-banner__body">
            {siteConfig.executiveBio.body}
          </p>
        </div>

        <div class="bio-banner__actions">
          <a href={siteConfig.executiveBio.ctaHref} class="btn-bio-cta" id="heroBookCallBtn">
            {siteConfig.executiveBio.ctaLabel}
          </a>
          <button type="button" class="btn-copy-email" id="copyEmailBtn">
            <span id="copyEmailText">Copy email</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ── SECTION 6: TERMINAL CONTACT DRAWER & MINIMAL FOOTER ──────── -->
    <section class="section-contact u-container" id="contact-drawer" tabindex="-1" aria-labelledby="contact-heading">
      <div class="terminal-card">
        <div class="terminal-card__header">
          <div class="terminal-header__left">
            <span class="terminal-badge">tty0 // INQUIRY SOCKET</span>
            <span class="terminal-title">console_inquiry.sh</span>
          </div>
          <span class="terminal-coords">
            Node: {siteConfig.brand.coordinates.label} [{siteConfig.brand.coordinates.lat}, {siteConfig.brand.coordinates.lng}]
          </span>
        </div>

        <div class="terminal-body">
          <div class="terminal-banner">
            <span class="terminal-banner__accent">{siteConfig.contactDrawer.title}</span>
            <span class="terminal-banner__sub">{siteConfig.contactDrawer.subtitle}</span>
          </div>

          <form
            class="terminal-form"
            id="contactForm"
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="_gotcha"
            action="/__forms.html"
          >
            {/* Netlify Form Identifier */}
            <input type="hidden" name="form-name" value="contact" />
            {/* Honeypots */}
            <input type="text" name="_gotcha" class="u-hidden" tabindex="-1" autocomplete="off" />
            <input type="text" name="company_fax" class="u-hidden" tabindex="-1" autocomplete="off" />

            <div class="form-grid">
              <div class="form-field">
                <label for="contact-subject" class="form-label">ENGAGEMENT_SCOPE:</label>
                <select id="contact-subject" name="subject" class="form-control">
                  {siteConfig.contactDrawer.scopes.map((scope) => (
                    <option value={scope}>{scope}</option>
                  ))}
                </select>
              </div>

              <div class="form-field">
                <label for="contact-name" class="form-label">OPERATOR_NAME:</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Dr. / Ms. / Mr. Name"
                  class="form-control"
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-email" class="form-label">TRANSMISSION_RETURN_ADDR:</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="name@organization.com"
                  class="form-control"
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-message" class="form-label">PAYLOAD_BUFFER:</label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="4"
                  placeholder="Specify systems requirements, advisory scope, or problem space..."
                  class="form-control form-control--textarea"
                ></textarea>
              </div>
            </div>

            <div class="terminal-footer">
              <span id="contactStatus" class="contact-status" aria-live="polite">
                [STATUS: IDLE — AWAITING OPERATOR DISPATCH]
              </span>
              <button type="submit" id="submitBtn" class="btn-transmit">
                [ TRANSMIT PACKET → ]
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Minimal Dark Footer -->
    <footer class="footer-minimal u-container" role="contentinfo">
      <div class="footer-inner">
        <div class="footer-left">
          <div class="footer-brand">
            <img
              src="/images/fotisp-logo.png"
              alt="Fotios Pastrakis Logo"
              class="footer-logo"
              width="24"
              height="26"
            />
            <span class="footer-wordmark">Fotios Pastrakis</span>
          </div>
          <span class="footer-coords">
            NODE: {siteConfig.brand.coordinates.label.toUpperCase()} · {siteConfig.brand.coordinates.lat}, {siteConfig.brand.coordinates.lng} · STATIC SHIP
          </span>
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="#work" class="footer-link">Work</a>
          <a href="#research" class="footer-link">Research</a>
          <a href="#methodology" class="footer-link">Architecture</a>
          <a href="/about" class="footer-link">About</a>
          <a
            href={siteConfig.brand.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            LinkedIn
          </a>
          <button type="button" class="footer-btn" id="footerEraToggle">
            1984 Mode (⇧⌥E)
          </button>
          <button type="button" class="footer-btn" id="footerDiagToggle">
            Diagnostic (⇧⌥D)
          </button>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  function initPageScripts() {
    // 1. Hook "Book a discovery call" CTA button
    const bookBtn = document.getElementById('heroBookCallBtn');
    if (bookBtn && bookBtn.dataset.listener !== 'true') {
      bookBtn.dataset.listener = 'true';
      bookBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const drawer = document.getElementById('contact-drawer');
        if (drawer) {
          drawer.scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => {
            const nameInput = document.getElementById('contact-name');
            nameInput?.focus();
          }, 350);
        }
      });
    }

    // 2. Hook "Copy email" button
    const copyBtn = document.getElementById('copyEmailBtn');
    const copyText = document.getElementById('copyEmailText');
    if (copyBtn && copyBtn.dataset.listener !== 'true') {
      copyBtn.dataset.listener = 'true';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard?.writeText('fotispastrakis@gmail.com').then(() => {
          if (copyText) {
            const orig = copyText.textContent;
            copyText.textContent = 'Copied to clipboard!';
            setTimeout(() => {
              copyText.textContent = orig;
            }, 2500);
          }
        });
      });
    }

    // 3. Footer Era Toggle and Diagnostic Buttons
    const footerEra = document.getElementById('footerEraToggle');
    if (footerEra && footerEra.dataset.listener !== 'true') {
      footerEra.dataset.listener = 'true';
      footerEra.addEventListener('click', () => {
        const cur = document.documentElement.dataset.era || '2026';
        const next = cur === '2026' ? '1984' : '2026';
        document.documentElement.dataset.era = next;
        localStorage.setItem('fotisp-era', next);
        window.dispatchEvent(new CustomEvent('era-changed', { detail: { era: next } }));
      });
    }

    const footerDiag = document.getElementById('footerDiagToggle');
    if (footerDiag && footerDiag.dataset.listener !== 'true') {
      footerDiag.dataset.listener = 'true';
      footerDiag.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-webdrift-installer'));
      });
    }

    // 4. Contact Form Dispatch to Netlify Forms
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const statusEl = document.getElementById('contactStatus');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

    if (form && statusEl && submitBtn && form.dataset.listener !== 'true') {
      form.dataset.listener = 'true';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        statusEl.textContent = '[STATUS: TRANSMITTING PACKET TO NETLIFY EDGE...]';
        statusEl.style.color = 'var(--color-text-muted)';
        submitBtn.disabled = true;

        try {
          const formData = new FormData(form);
          const body = new URLSearchParams(formData as any).toString();

          const res = await fetch('/__forms.html', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/x-www-form-urlencoded',
            },
            body,
          });

          if (res.ok) {
            statusEl.textContent = '[STATUS: 200_OK — INQUIRY LOGGED. DIRECT TRANSMISSION CONFIRMED]';
            statusEl.style.color = 'var(--color-accent)';
            form.reset();
          } else {
            statusEl.textContent = '[STATUS: TRANSMISSION ERROR — RETRY OR MAILTO fotispastrakis@gmail.com]';
            statusEl.style.color = 'var(--color-accent)';
          }
        } catch (_err) {
          statusEl.textContent = '[STATUS: NETWORK ERROR — MAIL DIRECTLY TO fotispastrakis@gmail.com]';
          statusEl.style.color = 'var(--color-accent)';
        } finally {
          submitBtn.disabled = false;
        }
      });
    }

    // 5. Bento Category Filter Buttons
    const filterButtons = document.querySelectorAll('.bento-filters .filter-pill');
    const bentoCards = document.querySelectorAll('.bento-grid-12 .bento-card');

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');

        const filter = (btn as HTMLElement).dataset.filter || 'all';

        bentoCards.forEach((card) => {
          const domain = (card as HTMLElement).dataset.domain || '';
          if (filter === 'all' || domain.includes(filter)) {
            (card as HTMLElement).style.opacity = '1';
            (card as HTMLElement).style.filter = 'none';
          } else {
            (card as HTMLElement).style.opacity = '0.35';
            (card as HTMLElement).style.filter = 'grayscale(0.6)';
          }
        });
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initPageScripts);
  document.addEventListener('astro:page-load', initPageScripts);
</script>

<style>
  .homepage {
    display: flex;
    flex-direction: column;
    gap: var(--space-24, 6rem);
    padding-top: var(--space-6, 1.5rem);
    padding-bottom: var(--space-16, 4rem);
    overflow-x: hidden;
  }

  .u-container {
    max-width: var(--container-2xl, 1440px);
    margin-inline: auto;
    padding-inline: var(--gutter, 1.5rem);
    width: 100%;
    box-sizing: border-box;
  }

  /* ── SECTION 1: HERO & RADAR HUD ───────────────────────────────── */
  .hero-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-12, 3rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: var(--space-10, 2.5rem);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hero-kicker {
    font-family: var(--font-mono, monospace);
    font-size: clamp(0.72rem, 0.9vw, 0.82rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent, #ee2626);
    margin: 0;
  }

  .hero-h1 {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2.5rem, 5.5vw, 4.4rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-h1__part1 {
    color: #f4f4f5;
  }

  .hero-h1__part2 {
    color: var(--color-accent, #ee2626);
  }

  .hero-body {
    font-family: var(--font-body, sans-serif);
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-text-muted, #a1a1aa);
    max-width: 62ch;
    margin: 0;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.6rem;
    background-color: var(--color-accent, #ee2626);
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-pill, 9999px);
    text-decoration: none;
    box-shadow: 0 0 20px rgba(238, 38, 38, 0.35);
    transition: all 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-hero-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 28px rgba(238, 38, 38, 0.55);
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    color: var(--color-text-main, #f4f4f5);
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: var(--radius-pill, 9999px);
    text-decoration: none;
    transition: all 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-hero-secondary:hover {
    border-color: var(--color-accent, #ee2626);
    color: #ffffff;
  }

  /* Orbital Radar HUD Bento Box */
  .hero-hud-bento {
    background: var(--color-bento-bg, rgba(15, 10, 12, 0.72));
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento, 24px);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .hud-bento__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hud-bento__dot-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hud-bento__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-accent, #ee2626);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .hud-bento__label {
    font-family: var(--font-mono, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-accent, #ee2626);
  }

  .hud-bento__coords {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--color-text-muted, #a1a1aa);
  }

  .hud-bento__canvas {
    min-height: 240px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hud-bento__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--color-text-faint, #71717a);
    border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    padding-top: 0.65rem;
  }

  /* 3-Column Authority Metric Strip */
  .hero-authority-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    border-top: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    padding-block: 1.5rem;
  }

  @media (max-width: 640px) {
    .hero-authority-strip {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .authority-tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .authority-tile__val {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.2rem, 1.8vw, 1.5rem);
    font-weight: 700;
    color: var(--color-accent, #ee2626);
  }

  .authority-tile__meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .authority-tile__lbl {
    font-family: var(--font-body, sans-serif);
    font-size: 0.88rem;
    font-weight: 600;
    color: #f4f4f5;
  }

  .authority-tile__ctx {
    font-family: var(--font-body, sans-serif);
    font-size: 0.78rem;
    color: var(--color-text-muted, #a1a1aa);
  }

  /* ── SECTION HEADERS COMMON ─────────────────────────────────────── */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: var(--space-8, 2rem);
    flex-wrap: wrap;
  }

  .section-kicker {
    display: inline-block;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent, #ee2626);
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #f4f4f5;
    margin: 0;
  }

  /* Filter Pills */
  .bento-filters {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(18, 12, 14, 0.85);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-pill, 9999px);
    padding: 0.25rem 0.35rem;
  }

  .filter-pill {
    background: transparent;
    border: none;
    color: var(--color-text-muted, #a1a1aa);
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    transition: all 180ms ease;
  }

  .filter-pill.is-active,
  .filter-pill:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .filter-pill.is-active {
    background: var(--color-accent, #ee2626);
    color: #ffffff;
    font-weight: 600;
  }

  /* ── SECTION 2: 12-COLUMN ASYMMETRIC BENTO GRID ────────────────── */
  .bento-grid-12 {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .bento-card {
    background: var(--color-bento-bg, rgba(15, 10, 12, 0.72));
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento, 24px);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
    backdrop-filter: blur(12px);
    transition: border-color 220ms ease, opacity 220ms ease, filter 220ms ease;
    box-sizing: border-box;
  }

  .bento-card:hover {
    border-color: var(--color-bento-border-hover, rgba(238, 38, 38, 0.35));
  }

  .bento-card--wide {
    grid-column: span 8;
  }

  .bento-card--tall {
    grid-column: span 4;
    padding: 0;
    background: transparent;
    border: none;
  }

  .bento-card--half {
    grid-column: span 6;
  }

  @media (max-width: 960px) {
    .bento-grid-12 {
      grid-template-columns: 1fr;
    }
    .bento-card--wide,
    .bento-card--tall,
    .bento-card--half {
      grid-column: span 1;
    }
  }

  .bento-card__preview {
    width: 100%;
  }

  .bento-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .bento-card__kicker {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--color-accent, #ee2626);
  }

  .bento-card__title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 700;
    line-height: 1.25;
    color: #f4f4f5;
    margin: 0;
  }

  .bento-card__summary {
    font-family: var(--font-body, sans-serif);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted, #a1a1aa);
    margin: 0;
  }

  .bento-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .bento-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    color: #d4d4d8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-subtle, 6px);
    padding: 0.2rem 0.5rem;
  }

  .bento-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    font-weight: 600;
    color: #f4f4f5;
    text-decoration: none;
    margin-top: 0.5rem;
    transition: color 180ms ease, transform 180ms ease;
  }

  .bento-card__link:hover {
    color: var(--color-accent, #ee2626);
    transform: translateX(3px);
  }

  /* ── SECTION 3: EMPIRICAL RIGOR & RESEARCH ROWS ────────────────── */
  .btn-all-writing {
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: var(--color-text-main, #f4f4f5);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: var(--radius-pill, 9999px);
    padding: 0.45rem 1rem;
    text-decoration: none;
    transition: all 180ms ease;
  }

  .btn-all-writing:hover {
    border-color: var(--color-accent, #ee2626);
    color: var(--color-accent, #ee2626);
  }

  .research-table {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
  }

  .research-row {
    display: grid;
    grid-template-columns: 240px 1fr 180px;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    transition: background-color 200ms ease;
  }

  .research-row:hover {
    background-color: rgba(255, 255, 255, 0.015);
  }

  @media (max-width: 840px) {
    .research-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      align-items: flex-start;
    }
  }

  .research-row__citation-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .research-citation-pill {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--color-accent, #ee2626);
    background: rgba(238, 38, 38, 0.08);
    border: 1px solid rgba(238, 38, 38, 0.28);
    border-radius: var(--radius-pill, 9999px);
    padding: 0.2rem 0.65rem;
    white-space: nowrap;
  }

  .research-row__num {
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    color: var(--color-text-faint, #71717a);
  }

  .research-row__body-col {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .research-row__title {
    font-family: var(--font-display, sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: #f4f4f5;
    margin: 0;
  }

  .research-row__thesis {
    font-family: var(--font-body, sans-serif);
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-text-muted, #a1a1aa);
    margin: 0;
  }

  .research-row__action-col {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 840px) {
    .research-row__action-col {
      justify-content: flex-start;
    }
  }

  .research-action-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.76rem;
    color: #f4f4f5;
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease;
  }

  .research-action-link:hover {
    color: var(--color-accent, #ee2626);
    transform: translateX(3px);
  }

  .research-preprint-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.66rem;
    color: var(--color-text-faint, #71717a);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-subtle, 6px);
    padding: 0.2rem 0.5rem;
  }

  /* ── SECTION 4: 2-COLUMN STICKY PHILOSOPHY ─────────────────────── */
  .methodology-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 880px) {
    .methodology-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  .methodology-left {
    position: sticky;
    top: calc(var(--systembar-height, 84px) + 2rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .methodology-title {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: #f4f4f5;
    margin: 0;
  }

  .methodology-narrative {
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-muted, #a1a1aa);
    margin: 0;
  }

  .methodology-right {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .methodology-pillar-card {
    background: var(--color-bento-bg, rgba(15, 10, 12, 0.72));
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento, 24px);
    padding: 1.5rem;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    transition: border-color 200ms ease;
  }

  .methodology-pillar-card:hover {
    border-color: var(--color-accent, #ee2626);
  }

  .pillar-node-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.35);
    border-radius: var(--radius-pill, 9999px);
    padding: 0.25rem 0.65rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .pillar-node-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent, #ee2626);
  }

  .pillar-node-step {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-accent, #ee2626);
  }

  .pillar-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-title {
    font-family: var(--font-display, sans-serif);
    font-size: 1.15rem;
    font-weight: 700;
    color: #f4f4f5;
    margin: 0;
  }

  .pillar-description {
    font-family: var(--font-body, sans-serif);
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-muted, #a1a1aa);
    margin: 0;
  }

  /* ── SECTION 5: BURGUNDY-CRIMSON EXECUTIVE BIO & CTA BANNER ──── */
  .executive-bio-banner {
    border-radius: var(--radius-banner, 20px);
    background: linear-gradient(135deg, #2b070c 0%, #4d0c16 55%, #1d0408 100%);
    border: 1px solid rgba(238, 38, 38, 0.45);
    padding: clamp(1.8rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
  }

  @media (max-width: 900px) {
    .executive-bio-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  .bio-banner__content {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bio-banner__kicker {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #ff8080;
  }

  .bio-banner__headline {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 700;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
  }

  .bio-banner__body {
    font-family: var(--font-body, sans-serif);
    font-size: 0.95rem;
    line-height: 1.65;
    color: #f4d0d4;
    margin: 0;
  }

  .bio-banner__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .btn-bio-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    background-color: var(--color-accent, #ee2626);
    color: #ffffff;
    font-family: var(--font-body, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    border-radius: var(--radius-pill, 9999px);
    text-decoration: none;
    box-shadow: 0 0 24px rgba(238, 38, 38, 0.45);
    white-space: nowrap;
    transition: all 200ms ease;
  }

  .btn-bio-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 32px rgba(238, 38, 38, 0.65);
  }

  .btn-copy-email {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7rem 1.4rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #f4f4f5;
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    border-radius: var(--radius-pill, 9999px);
    cursor: pointer;
    transition: all 180ms ease;
  }

  .btn-copy-email:hover {
    border-color: #ffffff;
    color: #ffffff;
  }

  /* ── SECTION 6: CONTACT DRAWER & MINIMAL FOOTER ────────────────── */
  .terminal-card {
    background: #090506;
    border: 1px solid var(--color-bento-border, rgba(255, 255, 255, 0.08));
    border-radius: var(--radius-bento, 24px);
    overflow: hidden;
  }

  .terminal-card__header {
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .terminal-header__left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .terminal-badge {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--color-accent, #ee2626);
    background: rgba(238, 38, 38, 0.1);
    border: 1px solid rgba(238, 38, 38, 0.3);
    border-radius: var(--radius-subtle, 6px);
    padding: 0.15rem 0.5rem;
  }

  .terminal-title {
    font-family: var(--font-mono, monospace);
    font-size: 0.78rem;
    color: #f4f4f5;
  }

  .terminal-coords {
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    color: var(--color-text-faint, #71717a);
  }

  .terminal-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .terminal-banner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .terminal-banner__accent {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-accent, #ee2626);
  }

  .terminal-banner__sub {
    font-family: var(--font-mono, monospace);
    font-size: 0.74rem;
    color: var(--color-text-muted, #a1a1aa);
