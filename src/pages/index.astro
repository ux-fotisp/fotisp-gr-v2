---
// src/pages/index.astro
// Stage 11: Visual & Structural Alignment to Desktop & Mobile Mockups
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoCaseStudyGrid from '../components/BentoCaseStudyGrid';
import ResearchWritingList from '../components/ResearchWritingList';
import EdgeLottie from '../components/EdgeLottie';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', (e) => !e.data.isDraft)).sort(
  (a, b) => (a.data.featuredOrder || a.data.order || 99) - (b.data.featuredOrder || b.data.order || 99)
);

const publications = (await getCollection('publications', (e) => !e.data.isDraft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const serializedCaseStudies = caseStudies.map((entry) => ({
  id: entry.id.replace(/\.mdx?$/, ''),
  title: entry.data.title,
  domain: entry.data.domain,
  role: entry.data.role,
  timeline: entry.data.timeline,
  summary: entry.data.summary,
  deliverables: entry.data.deliverables,
  status: entry.data.status,
  services: entry.data.services ? entry.data.services.map((s) => (typeof s === 'string' ? s : s.id)) : [],
  tagline: entry.data.tagline,
  category: entry.data.category,
  figureTag: entry.data.figureTag,
  year: entry.data.year,
  duration: entry.data.duration,
  protected: entry.data.protected,
}));

const serializedPublications = publications.map((pub) => ({
  id: pub.id.replace(/\.mdx?$/, ''),
  title: pub.data.title,
  venue: pub.data.venue,
  date: pub.data.date.toISOString(),
  doi: pub.data.doi,
  url: pub.data.url,
  year: pub.data.year,
  month: pub.data.month,
  abstract: pub.data.abstract,
  keywords: pub.data.keywords,
  domain: pub.data.domain,
}));

// Rich Schema.org ScholarlyArticle definitions for verified research
const scholarlySchemas = publications.map((pub) => ({
  '@type': 'ScholarlyArticle',
  headline: pub.data.title,
  name: pub.data.title,
  author: pub.data.authors.map((author) => ({
    '@type': 'Person',
    name: author,
  })),
  datePublished: pub.data.month ? `${pub.data.year}-${pub.data.month}` : `${pub.data.year}`,
  url: pub.data.url,
  sameAs: pub.data.doi ? `https://doi.org/${pub.data.doi}` : pub.data.url,
  ...(pub.data.abstract ? { description: pub.data.abstract } : {}),
}));

const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Fotios Pastrakis',
    alternateName: 'Fotis Pastrakis',
    url: 'https://fotisp.gr',
    sameAs: ['https://linkedin.com/in/fotisp', 'https://github.com/ux-fotisp'],
    jobTitle: 'Senior Associate, CX Designer',
    worksFor: {
      '@type': 'Organization',
      name: 'Pfizer',
      url: 'https://pfizer.com',
    },
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'University of the Aegean',
      url: 'https://www.aegean.gr',
    },
    knowsAbout: [
      'UX Research',
      'Product Design',
      'Design Systems',
      'Health Technology',
      'Clinical UX',
      'Information Architecture',
      'Cultural Heritage UX',
      'Accessibility',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Fotis Pastrakis Portfolio',
    url: 'https://fotisp.gr',
    description: 'Senior UX researcher, CX designer at Pfizer, and front-end systems architect.',
    author: { '@type': 'Person', name: 'Fotios Pastrakis' },
  },
  ...scholarlySchemas,
];
---

<BaseLayout schema={indexSchema}>
  <div class="homepage" id="top">
    <!-- ── SECTION 1: 2-COLUMN HERO & ORBITAL RADAR HUD ──────────── -->
    <section class="hero-section u-container" aria-labelledby="hero-title">
      <div class="hero-grid">
        {/* Left Column */}
        <div class="hero-copy">
          <p class="hero-eyebrow">
            PRODUCT DESIGNER · UX RESEARCHER · SYSTEMS ARCHITECT
          </p>

          <h1 id="hero-title" class="hero-h1">
            <span class="hero-h1__line1">Complexity, decoded.</span>
            <span class="hero-h1__line2">Systems, designed.</span>
          </h1>

          <p class="hero-body">
            I connect human needs and technical architecture—between the interface. Systems architecture, OOUX, and human-centered design for the real world.
          </p>

          <div class="hero-cta-row">
            <a href="#work" class="btn-hero-primary">
              See selected work <span class="arrow-right" aria-hidden="true">→</span>
            </a>
            <a href="#methodology" class="btn-hero-secondary">
              Explore approach <span class="arrow-down" aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        {/* Right Column: Orbital Radar HUD Card */}
        <div class="hero-hud-card">
          <div class="hud-card__header">
            <div class="hud-card__dot-title">
              <span class="hud-card__dot" aria-hidden="true"></span>
              <span class="hud-card__label">ORBITAL RADAR // LIVE</span>
            </div>
            <span class="hud-card__coords">40.64° N, 22.94° E</span>
          </div>

          <div class="hud-card__canvas">
            <EdgeLottie
              client:visible
              height="260px"
              fallbackText="THESSALONIKI · 40.64° N, 22.94° E"
            />
          </div>
        </div>
      </div>

      {/* Bottom Metadata Strip */}
      <div class="hero-metadata-strip" aria-label="Professional credentials & research track">
        <div class="metadata-col">
          <span class="metadata-col__text">10+ YEARS REGULATED UX · PFIZER & DELOITTE</span>
        </div>
        <div class="metadata-col">
          <span class="metadata-col__text">OOUX & COGNITIVE LOAD ARCHITECTURE</span>
        </div>
        <div class="metadata-col">
          <span class="metadata-col__text">PUBLISHED HCI RESEARCHER · MDPI & IEEE</span>
        </div>
      </div>
    </section>

    <!-- ── SECTION 2: ASYMMETRIC BENTO CASE STUDY GRID ───────────── -->
    <section class="section-work u-container" id="work" aria-labelledby="work-title">
      <BentoCaseStudyGrid client:load items={serializedCaseStudies} />
    </section>

    <!-- ── SECTION 3: RESEARCH & WRITING LIST ─────────────────────── -->
    <section class="section-research u-container" id="research" aria-labelledby="research-title">
      <ResearchWritingList client:load items={serializedPublications} />
    </section>

    <!-- ── SECTION 4: 2-COLUMN PHILOSOPHY SECTION ─────────────────── -->
    <section class="section-methodology u-container" id="methodology" aria-labelledby="methodology-title">
      <div class="methodology-grid">
        {/* Left Sticky Column */}
        <div class="methodology-left">
          <span class="methodology-eyebrow">METHODOLOGY</span>
          <h2 id="methodology-title" class="methodology-title">Clarity is an architectural decision.</h2>
          <p class="methodology-narrative">
            Great software systems don't happen by accident. I use Object-Oriented UX and cognitive load analysis to model complex domains before drawing screens, ensuring resilient architectures that scale.
          </p>
        </div>

        {/* Right Stacked Rows */}
        <div class="methodology-right">
          <div class="methodology-row">
            <div class="methodology-icon-badge" aria-hidden="true">
              <span class="icon-dot">●</span>
            </div>
            <div class="methodology-row__content">
              <h3 class="methodology-row__title">Find the objects</h3>
              <p class="methodology-row__desc">
                SIP-validated domain modeling before drawing screens. Map the real-world nouns and user mental models that give the domain its shape.
              </p>
            </div>
          </div>

          <div class="methodology-row">
            <div class="methodology-icon-badge" aria-hidden="true">
              <span class="icon-dot">●</span>
            </div>
            <div class="methodology-row__content">
              <h3 class="methodology-row__title">Make the system explicit</h3>
              <p class="methodology-row__desc">
                Bidirectional relationships, cardinality, and role-based CTAs to eliminate navigation dead-ends and cognitive disorientation.
              </p>
            </div>
          </div>

          <div class="methodology-row">
            <div class="methodology-icon-badge" aria-hidden="true">
              <span class="icon-dot">●</span>
            </div>
            <div class="methodology-row__content">
              <h3 class="methodology-row__title">Design for the edges</h3>
              <p class="methodology-row__desc">
                Clinical-grade accessibility, error recovery, and resilient states under high-stress operating conditions.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SECTION 5: CRIMSON GRADIENT BIO & CTA BANNER ───────────── -->
    <section class="section-bio u-container" aria-label="Personal introduction and call to action">
      <div class="crimson-bio-banner">
        <div class="bio-banner__left">
          <h2 class="bio-banner__title">
            Hi, I'm Fotis. I make the complicated feel considered.
          </h2>
          <p class="bio-banner__desc">
            Senior UX Researcher & Systems Architect with 10+ years navigating high-stakes, regulated environments with Pfizer and Deloitte. Specializing in clinical interfaces, OOUX, and design systems for mission-critical software. MSc in HCI from University of the Aegean (GPA 9.78/10).
          </p>
        </div>

        <div class="bio-banner__right">
          <span class="bio-kicker">OPEN FOR ADVISORY & ROLES</span>
          <a href="#contact-drawer" class="btn-discovery-cta" id="heroBookCallBtn">
            Book a discovery call <span class="arrow-right" aria-hidden="true">→</span>
          </a>
          <button type="button" class="btn-copy-email" id="copyEmailBtn">
            <span id="copyEmailText">Copy email</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ── SECTION 6: CONTACT TERMINAL & MINIMAL DARK FOOTER ──────── -->
    <section class="section-contact u-container" id="contact-drawer" tabindex="-1" aria-labelledby="contact-heading">
      <div class="terminal-card">
        <div class="terminal-card__header">
          <div class="terminal-header__left">
            <span class="terminal-badge">tty0 // INQUIRY SOCKET</span>
            <span class="terminal-title">console_inquiry.sh</span>
          </div>
          <span class="terminal-coords">Node: Thessaloniki [40.64° N, 22.94° E]</span>
        </div>

        <div class="terminal-body">
          <div class="terminal-banner">
            <span class="terminal-banner__accent">FOTISP-OS v2.6.0 · Cloudflare Edge D1 Endpoint</span>
            <span class="terminal-banner__sub">Select an engagement scope or dispatch an inquiry payload below.</span>
          </div>

          <form class="terminal-form" id="contactForm" method="POST" action="/api/contact">
            {/* Honeypots */}
            <input type="text" name="_gotcha" class="u-hidden" tabindex="-1" autocomplete="off" />
            <input type="text" name="company_fax" class="u-hidden" tabindex="-1" autocomplete="off" />

            <div class="form-grid">
              <div class="form-field">
                <label for="contact-subject" class="form-label">ENGAGEMENT_SCOPE:</label>
                <select id="contact-subject" name="subject" class="form-control">
                  <option value="general">General / Advisory Inquiry</option>
                  <option value="ux-research">Scoped Inquiry: UX Research & Validation</option>
                  <option value="design-systems">Scoped Inquiry: Design Systems Architecture</option>
                  <option value="ux-strategy">Scoped Inquiry: OOUX & Cognitive Load Analysis</option>
                </select>
              </div>

              <div class="form-field">
                <label for="contact-name" class="form-label">OPERATOR_NAME:</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  placeholder="Dr. / Ms. / Mr. Name"
                  class="form-control"
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-email" class="form-label">TRANSMISSION_RETURN_ADDR:</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  required
                  placeholder="name@organization.com"
                  class="form-control"
                />
              </div>

              <div class="form-field form-field--full">
                <label for="contact-message" class="form-label">PAYLOAD_BUFFER:</label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="4"
                  placeholder="Specify systems requirements, advisory scope, or problem space..."
                  class="form-control form-control--textarea"
                ></textarea>
              </div>
            </div>

            <div class="terminal-footer">
              <span id="contactStatus" class="contact-status" aria-live="polite">
                [STATUS: IDLE — AWAITING OPERATOR DISPATCH]
              </span>
              <button type="submit" id="submitBtn" class="btn-transmit">
                [ TRANSMIT PACKET → ]
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- Minimal Dark Footer -->
    <footer class="footer-minimal u-container" role="contentinfo">
      <div class="footer-inner">
        <div class="footer-left">
          <div class="footer-brand">
            <span class="footer-badge">[FP]</span>
            <span class="footer-wordmark">fotisp.gr</span>
          </div>
          <span class="footer-coords">NODE: THESSALONIKI · 40.64° N, 22.94° E · CLOUDFLARE EDGE</span>
        </div>

        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="#work" class="footer-link">Work</a>
          <a href="/about" class="footer-link">About</a>
          <a
            href="https://www.linkedin.com/in/fotispastrakis"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-link"
          >
            LinkedIn
          </a>
          <button type="button" class="footer-btn" id="footerEraToggle">
            1984 Mode (⇧⌥E)
          </button>
          <button type="button" class="footer-btn" id="footerDiagToggle">
            Diagnostic (⇧⌥D)
          </button>
        </nav>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  function initPageScripts() {
    // 1. Hook "Book a discovery call" CTA button
    const bookBtn = document.getElementById('heroBookCallBtn');
    if (bookBtn && bookBtn.dataset.listener !== 'true') {
      bookBtn.dataset.listener = 'true';
      bookBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const drawer = document.getElementById('contact-drawer');
        if (drawer) {
          drawer.scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => {
            const nameInput = document.getElementById('contact-name');
            nameInput?.focus();
          }, 350);
        }
      });
    }

    // 2. Hook "Copy email" button
    const copyBtn = document.getElementById('copyEmailBtn');
    const copyText = document.getElementById('copyEmailText');
    if (copyBtn && copyBtn.dataset.listener !== 'true') {
      copyBtn.dataset.listener = 'true';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard?.writeText('fotispastrakis@gmail.com').then(() => {
          if (copyText) {
            const orig = copyText.textContent;
            copyText.textContent = 'Copied to clipboard!';
            setTimeout(() => {
              copyText.textContent = orig;
            }, 2500);
          }
        });
      });
    }

    // 3. Footer Era Toggle and Diagnostic Buttons
    const footerEra = document.getElementById('footerEraToggle');
    if (footerEra && footerEra.dataset.listener !== 'true') {
      footerEra.dataset.listener = 'true';
      footerEra.addEventListener('click', () => {
        const cur = document.documentElement.dataset.era || '2026';
        const next = cur === '2026' ? '1984' : '2026';
        document.documentElement.dataset.era = next;
        localStorage.setItem('fotisp-era', next);
        window.dispatchEvent(new CustomEvent('era-changed', { detail: { era: next } }));
      });
    }

    const footerDiag = document.getElementById('footerDiagToggle');
    if (footerDiag && footerDiag.dataset.listener !== 'true') {
      footerDiag.dataset.listener = 'true';
      footerDiag.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-webdrift-installer'));
      });
    }

    // 4. Contact Form Dispatch to /api/contact
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const statusEl = document.getElementById('contactStatus');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;

    if (form && statusEl && submitBtn && form.dataset.listener !== 'true') {
      form.dataset.listener = 'true';
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        statusEl.textContent = '[STATUS: TRANSMITTING PACKET TO /api/contact...]';
        statusEl.style.color = 'var(--color-text-muted)';
        submitBtn.disabled = true;

        try {
          const formData = new FormData(form);
          const data: Record<string, string> = {};
          formData.forEach((value, key) => {
            data[key] = value.toString();
          });
          data.era = document.documentElement.dataset.era || '2026';

          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          const json = await res.json();
          if (res.ok && json.success) {
            statusEl.textContent = '[STATUS: 200_OK — INQUIRY_LOGGED: DISPATCHED TO FOTIS]';
            statusEl.style.color = 'var(--color-success)';
            form.reset();
          } else {
            statusEl.innerHTML = `[STATUS: ERR_RETRY — ${json.error || 'VERIFICATION FAILED'}] <a href="mailto:fotispastrakis@gmail.com" style="color: var(--color-accent); text-decoration: underline;">[MAILTO FALLBACK]</a>`;
            statusEl.style.color = 'var(--color-accent)';
          }
        } catch (err) {
          statusEl.innerHTML = `[STATUS: ERR_NETWORK] <a href="mailto:fotispastrakis@gmail.com" style="color: var(--color-accent); text-decoration: underline;">[MAILTO FALLBACK]</a>`;
          statusEl.style.color = 'var(--color-accent)';
        } finally {
          submitBtn.disabled = false;
        }
      });
    }
  }

  initPageScripts();
  document.addEventListener('astro:page-load', initPageScripts);
</script>

<style>
  /* ── Layout Framework ────────────────────────────── */
  .homepage {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 8vw, 7rem);
    padding-bottom: var(--space-12, 48px);
    width: 100%;
    overflow-x: hidden;
  }

  /* ── SECTION 1: HERO & HUD ───────────────────────── */
  .hero-section {
    padding-top: calc(var(--systembar-height, 84px) + var(--space-8, 32px));
    display: flex;
    flex-direction: column;
    gap: var(--space-10, 40px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10, 40px);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 56px;
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5, 20px);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 2.2rem + 3.8vw, 5.2rem);
    font-weight: var(--weight-black, 900);
    letter-spacing: -0.04em;
    line-height: 0.98;
    display: flex;
    flex-direction: column;
  }

  .hero-h1__line1 {
    color: var(--color-text-main);
  }

  .hero-h1__line2 {
    color: var(--color-accent);
  }

  .hero-body {
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 52ch;
  }

  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: var(--space-4, 16px);
    flex-wrap: wrap;
    padding-top: var(--space-2, 8px);
  }

  .btn-hero-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 26px;
    background-color: var(--color-accent);
    color: #ffffff;
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-pill);
    text-decoration: none;
    box-shadow: 0 0 24px rgba(238, 38, 38, 0.45);
    transition: all 0.2s ease;
  }

  .btn-hero-primary:hover {
    box-shadow: 0 0 32px rgba(238, 38, 38, 0.7);
    transform: translateY(-1px);
    color: #ffffff;
  }

  .btn-hero-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: rgba(18, 12, 14, 0.7);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 500;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-hero-secondary:hover {
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
  }

  .arrow-right,
  .arrow-down {
    font-family: var(--font-mono);
    font-size: 14px;
  }

  /* ── Right Column: Orbital HUD Card ──────────────── */
  .hero-hud-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border-crimson);
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
  }

  .hud-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 18px;
    background: rgba(22, 14, 17, 0.85);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 10.5px;
  }

  .hud-card__dot-title {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hud-card__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .hud-card__label {
    letter-spacing: 0.1em;
    color: var(--color-text-main);
  }

  .hud-card__coords {
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }

  .hud-card__canvas {
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #080303;
  }

  /* ── Metadata Strip ──────────────────────────────── */
  .hero-metadata-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 16px 0;
    gap: 16px;
  }

  .metadata-col {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4px 12px;
  }

  .metadata-col:not(:last-child) {
    border-right: 1px solid var(--color-border);
  }

  .metadata-col__text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .hero-metadata-strip {
      grid-template-columns: 1fr;
      gap: 10px;
