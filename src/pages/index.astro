---
// src/pages/index.astro
// Home — Swiss editorial hero + case study filter + services + publications
import BaseLayout from '../layouts/BaseLayout.astro';
import DesktopWindow from '../components/DesktopWindow.astro';
import CaseStudyGrid from '../components/CaseStudyGrid';
import { getCollection, getEntries } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', e => !e.data.isDraft))
  .sort((a, b) => (a.data.featuredOrder || a.data.order || 99) - (b.data.featuredOrder || b.data.order || 99));

const publications = (await getCollection('publications', e => !e.data.isDraft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const services = (await getCollection('services', e => !e.data.isDraft))
  .sort((a, b) => (a.data.featuredOrder || a.data.order || 99) - (b.data.featuredOrder || b.data.order || 99));

const serializedCaseStudies = caseStudies.map(entry => ({
  id: entry.id.replace(/\.mdx?$/, ''),
  title: entry.data.title,
  domain: entry.data.domain,
  role: entry.data.role,
  timeline: entry.data.timeline,
  summary: entry.data.summary,
  deliverables: entry.data.deliverables,
  status: entry.data.status,
  services: entry.data.services ? entry.data.services.map(s => typeof s === 'string' ? s : s.id) : [],
  publications: entry.data.publications ? entry.data.publications.map(p => typeof p === 'string' ? p : p.id) : [],
  tagline: entry.data.tagline,
  category: entry.data.category,
  figureTag: entry.data.figureTag,
  year: entry.data.year,
  duration: entry.data.duration,
  protected: entry.data.protected,
  problem: entry.data.problem,
  outcome: entry.data.outcome,
  impact: entry.data.impact,
}));

// Resolve inverse OOUX relationships for services at build time
const enrichedServices = await Promise.all(
  services.map(async (svc) => {
    const svcId = svc.id.replace(/\.mdx?$/, '');
    const provingStudies = caseStudies.filter((c) =>
      c.data.services && c.data.services.some((s) => (typeof s === 'string' ? s : s.id) === svcId)
    );
    const resolvedPubs = (svc.data.publications && svc.data.publications.length > 0)
      ? await getEntries(svc.data.publications)
      : [];
    return {
      svc,
      svcId,
      provingStudies,
      resolvedPubs,
    };
  })
);

// Rich Schema.org ScholarlyArticle definitions for verified research
const scholarlySchemas = publications.map(pub => ({
  '@type': 'ScholarlyArticle',
  headline: pub.data.title,
  name: pub.data.title,
  author: pub.data.authors.map(author => ({
    '@type': 'Person',
    name: author,
  })),
  datePublished: pub.data.month ? `${pub.data.year}-${pub.data.month}` : `${pub.data.year}`,
  url: pub.data.url,
  sameAs: pub.data.doi ? `https://doi.org/${pub.data.doi}` : pub.data.url,
  ...(pub.data.abstract ? { description: pub.data.abstract } : {}),
  ...(pub.data.venue
    ? {
        isPartOf: {
          '@type': 'Periodical',
          name: pub.data.venue,
          ...(pub.data.publisher
            ? {
                publisher: {
                  '@type': 'Organization',
                  name: pub.data.publisher,
                },
              }
            : {}),
        },
      }
    : {}),
  ...(pub.data.volume ? { volumeNumber: pub.data.volume } : {}),
  ...(pub.data.issue ? { issueNumber: pub.data.issue } : {}),
}));

const indexSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Fotios Pastrakis',
    alternateName: 'Fotis Pastrakis',
    url: 'https://fotisp.gr',
    sameAs: [
      'https://linkedin.com/in/fotisp',
      'https://github.com/ux-fotisp',
    ],
    jobTitle: 'Senior Associate, CX Designer',
    worksFor: [
      {
        '@type': 'Organization',
        name: 'Pfizer',
        url: 'https://pfizer.com',
      },
    ],
    alumniOf: [
      {
        '@type': 'CollegeOrUniversity',
        name: 'University of the Aegean',
        url: 'https://www.aegean.gr',
      },
    ],
    knowsAbout: [
      'UX Research', 'Product Design', 'Design Systems',
      'Health Technology', 'Clinical UX', 'Information Architecture',
      'Cultural Heritage UX', 'Accessibility',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Fotis Pastrakis Portfolio',
    url: 'https://fotisp.gr',
    description: 'Senior UX researcher, CX designer at Pfizer, and front-end systems architect.',
    author: { '@type': 'Person', name: 'Fotios Pastrakis' },
  },
  ...scholarlySchemas,
];
---
<BaseLayout schema={indexSchema}>
  <!-- ── HERO ──────────────────────────────────────────────────── -->
  <section class="hero u-container" aria-labelledby="hero-headline">
    <div class="hero__meta">
      <span class="section-label" aria-hidden="true">fp://index</span>
    </div>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow u-mono u-text-xs u-tracking-widest u-uppercase u-text-accent">
          Senior UX Researcher · Product Designer · Athens
        </p>
        <h1 id="hero-headline" class="hero__headline">
          Pixels change.<br />Architecture stays.
        </h1>
        <p class="hero__sub">
          I research, design, and systematise digital products that hold up under real use — in hospitals, civic operations centres, and consumer apps serving millions.
        </p>
        <nav class="hero__cta-row" aria-label="Primary navigation">
          <a href="/work" class="btn-primary">View Case Studies</a>
          <a href="/about" class="btn-ghost">About & CV</a>
        </nav>
      </div>

      <aside class="hero__status-window">
        <DesktopWindow
          title="system_status.log"
          fileBadge="v2.0"
          figureTag="Fig. 00"
          coordX={0.00}
          coordY={0.00}
        >
          <dl class="status-list">
            <div class="status-list__row">
              <dt class="u-mono u-text-xs u-text-faint">Current Role</dt>
              <dd class="u-mono u-text-xs u-text-muted">Senior Assoc. / CX Designer — Pfizer</dd>
            </div>
            <div class="status-list__row">
              <dt class="u-mono u-text-xs u-text-faint">Research Area</dt>
              <dd class="u-mono u-text-xs u-text-muted">Clinical UX · AI transparency · Cultural HCI</dd>
            </div>
            <div class="status-list__row">
              <dt class="u-mono u-text-xs u-text-faint">MSc GPA</dt>
              <dd class="u-mono u-text-xs u-text-muted">9.78 / 10 — Univ. of the Aegean</dd>
            </div>
            <div class="status-list__row">
              <dt class="u-mono u-text-xs u-text-faint">Publications</dt>
              <dd class="u-mono u-text-xs u-text-muted">{publications.length} peer-reviewed</dd>
            </div>
            <div class="status-list__row">
              <dt class="u-mono u-text-xs u-text-faint">Case Studies</dt>
              <dd class="u-mono u-text-xs u-text-muted">{caseStudies.length} in portfolio</dd>
            </div>
          </dl>
        </DesktopWindow>
      </aside>
    </div>
  </section>

  <!-- ── CASE STUDIES FILTER & GRID ───────────────────────────── -->
  <section class="work-section u-container" aria-labelledby="work-heading" id="work">
    <header class="section-header">
      <span class="section-label">Selected Work</span>
      <h2 id="work-heading" class="section-title">Case Studies & Systems</h2>
    </header>

    <CaseStudyGrid client:load items={serializedCaseStudies} mode="grid" />
  </section>

  <!-- ── SERVICES ───────────────────────────────────────────────── -->
  <section class="services-section u-container" aria-labelledby="services-heading" id="services">
    <header class="section-header">
      <span class="section-label">What I Do</span>
      <h2 id="services-heading" class="section-title">Services & Architecture</h2>
    </header>

    <div class="services-grid">
      {enrichedServices.map(({ svc, svcId, provingStudies, resolvedPubs }) => (
        <article class="service-card u-window u-border-1bit" id={`service-${svcId}`}>
          <div class="service-card__header">
            <span class="service-card__tag u-mono u-text-xs u-text-faint">{svc.data.figureTag || 'Svc. ??'}</span>
            <span class="service-card__id u-mono u-text-xs u-text-accent">svc://{svcId}</span>
          </div>

          <h3 class="service-card__title">{svc.data.name || svc.data.title}</h3>
          <p class="service-card__desc">{svc.data.description}</p>

          <!-- Core Methodologies -->
          {svc.data.methodologies && svc.data.methodologies.length > 0 && (
            <div class="service-card__block">
              <span class="service-card__label u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">
                Methodologies:
              </span>
              <ul class="method-tags">
                {svc.data.methodologies.map(m => (
                  <li class="u-mono u-text-xs">{m}</li>
                ))}
              </ul>
            </div>
          )}

          <!-- Deliverables -->
          <div class="service-card__block">
            <span class="service-card__label u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">
              Key Deliverables:
            </span>
            <ul class="deliverables-list">
              {svc.data.deliverables.slice(0, 4).map(d => (
                <li class="u-mono u-text-xs u-text-muted">{d}</li>
              ))}
            </ul>
          </div>

          <!-- [O:REF] Proving Work -->
          {provingStudies.length > 0 && (
            <div class="service-card__rel-block u-border-1bit-top">
              <span class="service-card__label u-mono u-text-xs u-text-accent u-uppercase u-tracking-widest">
                [O:REF] PROVING WORK:
              </span>
              <ul class="proving-list">
                {provingStudies.map(cs => (
                  <li>
                    <a href={`/work/${cs.id.replace(/\.mdx?$/, '')}`} class="u-mono u-text-xs">
                      → {cs.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- [O:REF] Academic Grounding -->
          {resolvedPubs.length > 0 && (
            <div class="service-card__rel-block u-border-1bit-top">
              <span class="service-card__label u-mono u-text-xs u-text-accent u-uppercase u-tracking-widest">
                [O:REF] ACADEMIC GROUNDING:
              </span>
              <ul class="grounding-list">
                {resolvedPubs.map(pub => (
                  <li>
                    <a
                      href={pub.data.doi ? `https://doi.org/${pub.data.doi}` : pub.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="u-mono u-text-xs"
                    >
                      ⊞ {pub.data.venue} ({pub.data.year || new Date(pub.data.date).getFullYear()}): {pub.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- CTA Scoped Inquiry -->
          <div class="service-card__cta u-border-1bit-top">
            <a
              href="#contact-drawer"
              data-service-select={svcId}
              class="btn-scoped-inquiry u-mono u-text-xs"
            >
              [ INITIATE SCOPED INQUIRY ]
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ── PUBLICATIONS ────────────────────────────────────────────── -->
  <section class="pubs-section u-container" aria-labelledby="pubs-heading" id="publications">
    <header class="section-header">
      <span class="section-label">Peer-Reviewed Research</span>
      <h2 id="pubs-heading" class="section-title">Publications</h2>
    </header>

    <DesktopWindow
      title="bibliography.bib"
      figureTag="Bib. 01"
      coordX={0.90}
      coordY={0.80}
    >
      <ol class="pub-list" reversed>
        {publications.map((pub) => (
          <li class="pub-item u-border-1bit-bottom">
            <span class="pub-item__year u-mono u-text-xs u-text-faint">{pub.data.year || new Date(pub.data.date).getFullYear()}</span>
            <div class="pub-item__body">
              <h3 class="pub-item__title">
                {pub.data.url ? (
                  <a href={pub.data.url} target="_blank" rel="noopener noreferrer">
                    {pub.data.title}
                  </a>
                ) : pub.data.title}
              </h3>
              <p class="pub-item__meta u-mono u-text-xs u-text-faint">
                {pub.data.authors.join(', ')} ·{' '}
                <em>{pub.data.venue}</em>
                {pub.data.volume && `, Vol. ${pub.data.volume}`}
                {pub.data.articleNumber && `, No. ${pub.data.articleNumber}`}
                {pub.data.month && ` · ${pub.data.month} ${pub.data.year || new Date(pub.data.date).getFullYear()}`}
              </p>
              {pub.data.doi && (
                <a
                  href={`https://doi.org/${pub.data.doi}`}
                  class="pub-item__doi u-mono u-text-xs"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`DOI for ${pub.data.title}`}
                >
                  DOI: {pub.data.doi}
                </a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </DesktopWindow>
  </section>

  <!-- ── CONTACT DRAWER / RETRO TERMINAL ───────────────────────── -->
  <section class="contact-section u-container" id="contact-drawer" tabindex="-1" aria-labelledby="contact-heading">
    <header class="section-header">
      <span class="section-label">Transmission Terminal</span>
      <h2 id="contact-heading" class="section-title">Initiate Scoped Inquiry</h2>
    </header>

    <DesktopWindow
      title="console_inquiry.sh"
      fileBadge="tty0"
      figureTag="Terminal 01"
      coordX={0.50}
      coordY={0.50}
    >
      <div class="terminal-box">
        <div class="terminal-banner u-mono u-text-xs">
          <p class="u-text-accent">FOTISP-OS v2.6.0 [Athens Host Node · Cloudflare Edge]</p>
          <p class="u-text-faint">Select a service scope or dispatch an asynchronous inquiry payload below.</p>
        </div>

        <form class="terminal-form" id="contactForm" method="POST" action="/api/contact">
          <!-- Honeypot anti-bot fields -->
          <input type="text" name="_gotcha" class="u-hidden" tabindex="-1" autocomplete="off" />
          <input type="text" name="company_fax" class="u-hidden" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <label for="contact-subject" class="u-mono u-text-xs u-text-faint">ENGAGEMENT_SCOPE:</label>
            <select id="contact-subject" name="subject" class="terminal-input terminal-select">
              <option value="general">General / Advisory Inquiry</option>
              <option value="ux-research">Scoped Inquiry: UX Research</option>
              <option value="design-systems">Scoped Inquiry: Design Systems</option>
              <option value="ux-strategy">Scoped Inquiry: UX Strategy & Leadership</option>
            </select>
          </div>

          <div class="form-row">
            <label for="contact-name" class="u-mono u-text-xs u-text-faint">OPERATOR_NAME:</label>
            <input
              type="text"
              id="contact-name"
              name="name"
              required
              placeholder="Dr. / Ms. / Mr. Name"
              class="terminal-input"
            />
          </div>

          <div class="form-row">
            <label for="contact-email" class="u-mono u-text-xs u-text-faint">TRANSMISSION_RETURN_ADDR:</label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="name@domain.com"
              class="terminal-input"
            />
          </div>

          <div class="form-row">
            <label for="contact-message" class="u-mono u-text-xs u-text-faint">PAYLOAD_BUFFER:</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Specify requirements, advisory scope, or research problem..."
              class="terminal-input terminal-textarea"
            ></textarea>
          </div>

          <div class="terminal-form__footer">
            <span id="contactStatus" class="u-mono u-text-xs u-text-faint" aria-live="polite">
              [STATUS: IDLE — AWAITING OPERATOR DISPATCH]
            </span>
            <button type="submit" id="submitBtn" class="terminal-btn u-mono u-text-xs">
              [ TRANSMIT PACKET ]
            </button>
          </div>
        </form>
      </div>
    </DesktopWindow>
  </section>
</BaseLayout>

<script>
  function initContactTerminal() {
    const form = document.getElementById('contactForm') as HTMLFormElement | null;
    const statusEl = document.getElementById('contactStatus');
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const subjectSelect = document.getElementById('contact-subject') as HTMLSelectElement | null;

    // Handle "Initiate Scoped Inquiry" clicks across the page
    const inquiryButtons = document.querySelectorAll<HTMLElement>('[data-service-select]');
    inquiryButtons.forEach((btn) => {
      if (btn.dataset.listenerAttached === 'true') return;
      btn.dataset.listenerAttached = 'true';

      btn.addEventListener('click', (e) => {
        const svcId = btn.getAttribute('data-service-select');
        if (svcId && subjectSelect) {
          subjectSelect.value = svcId;
        }
        const drawer = document.getElementById('contact-drawer');
        if (drawer) {
          drawer.scrollIntoView({ behavior: 'smooth' });
          setTimeout(() => {
            const nameInput = document.getElementById('contact-name');
            nameInput?.focus();
          }, 400);
        }
      });
    });

    // Check URL query parameters for ?service=...
    const urlParams = new URLSearchParams(window.location.search);
    const requestedService = urlParams.get('service');
    if (requestedService && subjectSelect) {
      subjectSelect.value = requestedService;
    }

    if (!form || !statusEl || !submitBtn) return;
    if (form.dataset.listenerAttached === 'true') return;
    form.dataset.listenerAttached = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = '[STATUS: TRANSMITTING... DISPATCHING PACKET TO /api/contact]';
      statusEl.style.color = 'var(--color-text-muted)';
      submitBtn.disabled = true;

      try {
        const formData = new FormData(form);
        const data: Record<string, string> = {};
        formData.forEach((value, key) => {
          data[key] = value.toString();
        });

        // Pass active client era
        data.era = document.documentElement.dataset.era || '2026';

        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const json = await res.json();
        if (res.ok && json.success) {
          statusEl.textContent = '[STATUS: 200_OK — INQUIRY_LOGGED: DISPATCHED TO FOTIS]';
          statusEl.style.color = 'var(--color-success)';
          form.reset();
        } else {
          statusEl.innerHTML = `[STATUS: ERR_RETRY_OR_MAILTO — ${json.error || 'VERIFICATION FAILED'}] <a href="mailto:fotis@fotisp.gr" class="u-text-accent">[MAILTO FALLBACK]</a>`;
          statusEl.style.color = 'var(--color-accent)';
        }
      } catch (err) {
        statusEl.innerHTML = '[STATUS: ERR_RETRY_OR_MAILTO — NETWORK DROPPED] <a href="mailto:fotis@fotisp.gr" class="u-text-accent">[MAILTO FALLBACK]</a>';
        statusEl.style.color = 'var(--color-accent)';
      } finally {
        submitBtn.disabled = false;
      }
    });
  }

  initContactTerminal();
  document.addEventListener('astro:page-load', initContactTerminal);
</script>

<style>
  /* ── Layout variables ─────────────────────────── */
  :root {
    --section-gap: clamp(4rem, 10vw, 8rem);
  }

  /* ── Hero ─────────────────────────────────────── */
  .hero {
    padding-top: calc(var(--systembar-height) + var(--space-16));
    padding-bottom: var(--section-gap);
  }

  .hero__meta { margin-bottom: var(--space-6); }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-16);
    }
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: var(--space-4);
    color: var(--color-accent);
  }

  .hero__headline {
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-6);
  }

  .hero__sub {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 54ch;
    margin-bottom: var(--space-10);
  }

  .hero__cta-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ── Buttons ──────────────────────────────────── */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    text-decoration: none;
    border: var(--border-1bit-accent);
    transition: background-color var(--duration-fast) var(--ease-out-quart),
                color var(--duration-fast) var(--ease-out-quart);
  }

  .btn-primary:hover {
    background-color: transparent;
    color: var(--color-accent);
  }

  .btn-primary:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background-color: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border: var(--border-1bit);
    transition: color var(--duration-fast) var(--ease-out-quart),
                border-color var(--duration-fast) var(--ease-out-quart);
  }

  .btn-ghost:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn-ghost:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* ── Status list ──────────────────────────────── */
  .status-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .status-list__row {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: var(--border-1bit-subtle);
  }

  .status-list__row:last-child { border-bottom: none; }

  /* ── Section header ───────────────────────────── */
  .section-header {
    margin-bottom: var(--space-10);
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  /* ── Work section ─────────────────────────────── */
  .work-section {
    padding-block: var(--section-gap);
    border-top: var(--border-1bit);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

