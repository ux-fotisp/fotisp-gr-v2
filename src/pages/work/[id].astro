---
// src/pages/work/[id].astro
// Dynamic case study reader — OS inspector window frame
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DesktopWindow from '../../components/DesktopWindow.astro';
import JsonLd from '../../components/JsonLd.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies');
  return entries.map(entry => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { id: slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);

const d = entry.data;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.tagline,
    author: { '@type': 'Person', name: 'Fotios Pastrakis', url: 'https://fotisp.gr' },
    datePublished: `${d.year}-01-01`,
    publisher: { '@type': 'Person', name: 'Fotios Pastrakis', url: 'https://fotisp.gr' },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://fotisp.gr/work/${slug}`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://fotisp.gr',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Case Studies',
        item: 'https://fotisp.gr/work',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: d.title,
        item: `https://fotisp.gr/work/${slug}`,
      },
    ],
  },
];
---
<BaseLayout
  title={`${d.title} — Case Study | Fotis Pastrakis`}
  description={d.tagline}
  schema={schema}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
  </Fragment>

  <!-- Back nav -->
  <nav class="case-nav u-container" aria-label="Case study navigation">
    <a href="/work" class="case-nav__back u-mono u-text-xs">
      ← All Case Studies
    </a>
    <span class="case-nav__id u-mono u-text-xs u-text-faint">{slug}</span>
  </nav>

  <!-- Main window -->
  <article class="case-article u-container">
    <DesktopWindow
      title={d.title}
      fileBadge={`${slug}.mdx`}
      figureTag={d.figureTag ?? 'Fig. ??'}
      coordX={0.70}
      coordY={0.33}
      scrollable={false}
      noPadding={true}
    >
      <!-- Article header (inside the window, before the body) -->
      <header class="case-header">
        <div class="case-header__meta">
          <span class="tag tag--category">
            {d.category.replace(/-/g, ' ')}
          </span>
          <span class="tag">{d.year}</span>
          {d.duration && <span class="tag">{d.duration}</span>}
          {d.protected && (
            <span class="tag tag--protected" title="Content partially redacted under NDA">NDA</span>
          )}
        </div>

        <h1 class="case-header__title">{d.title}</h1>
        <p class="case-header__tagline">{d.tagline}</p>

        <!-- Role + Team -->
        <dl class="case-header__credits">
          <div>
            <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Role</dt>
            <dd class="u-text-sm u-text-muted">{d.role}</dd>
          </div>
          {d.team && (
            <div>
              <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Team</dt>
              <dd class="u-text-sm u-text-muted">{d.team}</dd>
            </div>
          )}
          {d.client && (
            <div>
              <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Client</dt>
              <dd class="u-text-sm u-text-muted">{d.client}</dd>
            </div>
          )}
        </dl>
      </header>

      <!-- Impact metrics band -->
      {d.impact && d.impact.length > 0 && (
        <div class="case-impact" aria-label="Key outcomes">
          {d.impact.map(imp => (
            <div class="case-impact__item">
              <span class="case-impact__value">{imp.value}</span>
              <span class="case-impact__metric u-mono u-text-xs">{imp.metric}</span>
              {imp.context && (
                <span class="case-impact__context u-mono u-text-xs u-text-faint">{imp.context}</span>
              )}
            </div>
          ))}
        </div>
      )}

      <!-- Problem / Outcome columns -->
      <div class="case-columns">
        <div class="case-columns__block">
          <h2 class="case-columns__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
            Problem
          </h2>
          <p class="case-columns__body">{d.problem}</p>
        </div>
        <div class="case-columns__block">
          <h2 class="case-columns__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
            Outcome
          </h2>
          <p class="case-columns__body">{d.outcome}</p>
        </div>
      </div>

      <!-- Process phases -->
      {d.process && d.process.length > 0 && (
        <section class="case-process" aria-labelledby="process-heading">
          <h2 id="process-heading" class="case-section-heading">Process</h2>
          <ol class="case-process__list">
            {d.process.map((phase, i) => (
              <li class="case-process__phase">
                <span class="case-process__num u-mono u-text-xs u-text-faint">
                  0{i + 1}
                </span>
                <div>
                  <h3 class="case-process__label">{phase.phase}</h3>
                  <p class="case-process__desc">{phase.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- MDX body content -->
      <div class="case-prose">
        <Content />
      </div>

      <!-- Methods + Tools + Deliverables -->
      <footer class="case-footer">
        {d.methods.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Methods
            </h2>
            <ul class="tag-cloud" aria-label="Research methods">
              {d.methods.map(m => <li class="tag">{m}</li>)}
            </ul>
          </div>
        )}
        {d.tools.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Tools
            </h2>
            <ul class="tag-cloud" aria-label="Tools used">
              {d.tools.map(t => <li class="tag">{t}</li>)}
            </ul>
          </div>
        )}
        {d.deliverables.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Deliverables
            </h2>
            <ul class="tag-cloud" aria-label="Deliverables">
              {d.deliverables.map(del => <li class="tag">{del}</li>)}
            </ul>
          </div>
        )}
      </footer>
    </DesktopWindow>

    <!-- Next case studies -->
    <nav class="case-next" aria-label="More case studies">
      <a href="/work" class="btn-ghost u-mono u-text-xs">View All Case Studies →</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .case-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: calc(var(--systembar-height) + var(--space-6));
    padding-bottom: var(--space-6);
  }

  .case-nav__back {
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: var(--tracking-wide);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }
  .case-nav__back:hover { color: var(--color-accent); }

  .case-article {
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  /* ── Article header ─────────────────────── */
  .case-header {
    padding: var(--space-10) var(--space-8) var(--space-8);
    border-bottom: var(--border-1bit);
  }

  .case-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .tag { display: inline-block; padding: 2px var(--space-2); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-faint); border: var(--border-1bit-subtle); letter-spacing: var(--tracking-wide); }
  .tag--category { color: var(--color-text-muted); border-color: var(--color-border); }
  .tag--protected { color: var(--color-accent); border-color: var(--color-accent); }

  .case-header__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .case-header__tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 70ch;
    margin-bottom: var(--space-8);
  }

  .case-header__credits {
    display: flex;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .case-header__credits dt { margin-bottom: var(--space-1); }
  .case-header__credits dd { margin: 0; }

  /* ── Impact band ────────────────────────── */
  .case-impact {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: var(--border-1bit);
  }

  .case-impact__item {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-8);
    border-right: var(--border-1bit);
  }

  .case-impact__item:last-child { border-right: none; }

  .case-impact__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    color: var(--color-accent);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .case-impact__metric {
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case-impact__context { color: var(--color-text-faint); }

  /* ── Problem / Outcome ──────────────────── */
  .case-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-bottom: var(--border-1bit);
  }

  @media (min-width: 768px) {
    .case-columns { grid-template-columns: 1fr 1fr; }
  }

  .case-columns__block {
    padding: var(--space-8);
    border-right: var(--border-1bit);
  }

  .case-columns__block:last-child { border-right: none; }

  .case-columns__heading {
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-3);
  }

  .case-columns__body {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Process ────────────────────────────── */
  .case-process {
    padding: var(--space-8);
    border-bottom: var(--border-1bit);
  }

  .case-section-heading {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-6);
  }

  .case-process__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .case-process__phase {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: var(--border-1bit-subtle);
  }

  .case-process__phase:last-child { border-bottom: none; }

  .case-process__num {
    padding-top: 2px;
    letter-spacing: var(--tracking-wide);
  }

  .case-process__label {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .case-process__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── MDX prose ──────────────────────────── */
  .case-prose {
    padding: var(--space-8);
    border-bottom: var(--border-1bit);
    max-width: 72ch;
  }

  .case-prose :global(h2) {
    font-size: var(--text-xl);
    color: var(--color-text);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .case-prose :global(h3) {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .case-prose :global(p) {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .case-prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: var(--space-4);
    margin: var(--space-6) 0;
    color: var(--color-text-faint);
    font-style: italic;
  }

  /* ── Footer ─────────────────────────────── */
  .case-footer {
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-footer__heading {
    margin-bottom: var(--space-3);
  }

  .tag-cloud {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ── Next nav ───────────────────────────── */
  .case-next {
    margin-top: var(--space-8);
    display: flex;
    justify-content: flex-end;
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    color: var(--color-text-muted);
    text-decoration: none;
    border: var(--border-1bit);
    letter-spacing: var(--tracking-wide);
    transition: color var(--duration-fast) var(--ease-out-quart),
                border-color var(--duration-fast) var(--ease-out-quart);
  }
  .btn-ghost:hover { color: var(--color-text); border-color: var(--color-border-strong); }
</style>
