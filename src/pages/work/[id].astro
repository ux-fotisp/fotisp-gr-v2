---
// src/pages/work/[id].astro
// Dynamic case study reader — OS inspector window frame
import { getCollection, getEntries, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DesktopWindow from '../../components/DesktopWindow.astro';
import CaseStudyDiagram from '../../components/CaseStudyDiagram.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies');
  return entries.map((entry: CollectionEntry<'caseStudies'>) => {
    const slug = entry.id.replace(/\.mdx?$/, '');
    return {
      params: { id: slug },
      props: { entry, slug },
    };
  });
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  slug: string;
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);

const d = entry.data as any;

// Resolve OOUX references
const resolvedServices = (d.services && d.services.length > 0) ? await getEntries(d.services) : [];
const resolvedPublications = (d.publications && d.publications.length > 0) ? await getEntries(d.publications) : [];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.tagline,
    author: { '@type': 'Person', name: 'Fotios Pastrakis', url: 'https://fotisp.gr' },
    datePublished: `${d.year}-01-01`,
    publisher: { '@type': 'Person', name: 'Fotios Pastrakis', url: 'https://fotisp.gr' },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://fotisp.gr/work/${slug}`,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://fotisp.gr',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Case Studies',
        item: 'https://fotisp.gr/work',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: d.title,
        item: `https://fotisp.gr/work/${slug}`,
      },
    ],
  },
];
---
<BaseLayout
  title={`${d.title} — Case Study | Fotis Pastrakis`}
  description={d.tagline}
  schema={schema}
>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
  </Fragment>

  <!-- Back nav -->
  <nav class="case-nav u-container" aria-label="Case study navigation">
    <a href="/work" class="case-nav__back u-mono u-text-xs">
      ← All Case Studies
    </a>
    <span class="case-nav__id u-mono u-text-xs u-text-faint">{slug}</span>
  </nav>

  <!-- Main window -->
  <article class="case-article u-container">
    <DesktopWindow
      title={d.title}
      fileBadge={`${slug}.mdx`}
      figureTag={d.figureTag ?? 'Fig. ??'}
      coordX={0.70}
      coordY={0.33}
      scrollable={false}
      noPadding={true}
    >
      <!-- Article header (inside the window, before the body) -->
      <header class="case-header">
        <div class="case-header__meta">
          <span class="tag tag--category">
            {d.category.replace(/-/g, ' ')}
          </span>
          <span class="tag">{d.year}</span>
          {d.duration && <span class="tag">{d.duration}</span>}
          {d.protected && (
            <span class="tag tag--protected" title="Content partially redacted under NDA">NDA</span>
          )}
        </div>

        <h1 class="case-header__title">{d.title}</h1>
        <p class="case-header__tagline">{d.tagline}</p>

        <!-- Role + Team -->
        <dl class="case-header__credits">
          <div>
            <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Role</dt>
            <dd class="u-text-sm u-text-muted">{d.role}</dd>
          </div>
          {d.team && (
            <div>
              <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Team</dt>
              <dd class="u-text-sm u-text-muted">{d.team}</dd>
            </div>
          )}
          {d.client && (
            <div>
              <dt class="u-mono u-text-xs u-text-faint u-uppercase u-tracking-widest">Client</dt>
              <dd class="u-text-sm u-text-muted">{d.client}</dd>
            </div>
          )}
        </dl>

        <!-- Linked Services (OOUX [O:REF] Matrix) -->
        {resolvedServices.length > 0 && (
          <div class="case-header__services">
            <span class="u-mono u-text-xs u-text-accent u-tracking-widest u-uppercase">[O:REF] SERVICES:</span>
            <div class="service-badges">
              {resolvedServices.map((svc: any) => (
                <a href="/#services" class="tag tag--service">
                  <span class="u-mono u-text-xs">⊞ {svc.data.name || svc.data.title}</span>
                </a>
              ))}
            </div>
          </div>
        )}
      </header>

      <!-- Impact metrics band -->
      {d.impact && d.impact.length > 0 && (
        <div class="case-impact" aria-label="Key outcomes">
          {d.impact.map((imp: any) => (
            <div class="case-impact__item">
              <span class="case-impact__value">{imp.value}</span>
              <span class="case-impact__metric u-mono u-text-xs">{imp.metric}</span>
              {imp.context && (
                <span class="case-impact__context u-mono u-text-xs u-text-faint">{imp.context}</span>
              )}
            </div>
          ))}
        </div>
      )}

      <!-- Problem / Outcome columns -->
      <div class="case-columns">
        <div class="case-columns__block">
          <h2 class="case-columns__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
            Problem
          </h2>
          <p class="case-columns__body">{d.problem}</p>
        </div>
        <div class="case-columns__block">
          <h2 class="case-columns__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
            Outcome
          </h2>
          <p class="case-columns__body">{d.outcome}</p>
        </div>
      </div>

      <!-- Process phases -->
      {d.process && d.process.length > 0 && (
        <section class="case-process" aria-labelledby="process-heading">
          <h2 id="process-heading" class="case-section-heading">Process</h2>
          <ol class="case-process__list">
            {d.process.map((phase: any, i: number) => (
              <li class="case-process__phase">
                <span class="case-process__num u-mono u-text-xs u-text-faint">
                  0{i + 1}
                </span>
                <div>
                  <h3 class="case-process__label">{phase.phase}</h3>
                  <p class="case-process__desc">{phase.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Visual Architectural Schematic or Cinematic 3D Infographic -->
      <section class="case-schematic-section" aria-label="System Architecture Schematic">
        {d.diagramType === '3d' ? (
          <DesktopWindow
            title={`cinematic_3d_infographic_${slug}.mesh`}
            fileBadge="GLTF / 3D"
            figureTag={d.figureTag ?? '3D. 01'}
          >
            <div class="cinematic-3d-placeholder window-content">
              <div class="cinematic-3d-placeholder__canvas">
                <svg viewBox="0 0 800 400" class="cinematic-3d-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="3D Interactive Polygonal Architecture">
                  <defs>
                    <radialGradient id={`mesh-glow-${slug}`} cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#EE2626" stop-opacity="0.32" />
                      <stop offset="60%" stop-color="#EE2626" stop-opacity="0.08" />
                      <stop offset="100%" stop-color="#080303" stop-opacity="0" />
                    </radialGradient>
                    <pattern id={`grid-dots-3d-${slug}`} width="20" height="20" patternUnits="userSpaceOnUse">
                      <circle cx="2" cy="2" r="1" fill="#EE2626" fill-opacity="0.2" />
                    </pattern>
                  </defs>
                  <rect width="800" height="400" fill="#080303" />
                  <rect width="800" height="400" fill={`url(#grid-dots-3d-${slug})`} />
                  <circle cx="400" cy="200" r="180" fill={`url(#mesh-glow-${slug})`} />

                  <!-- Isometric 3D Wireframe Polyhedron -->
                  <g class="mesh-3d-group" stroke="var(--color-accent)" stroke-width="1.2" fill="none">
                    <!-- Top Face -->
                    <polygon points="400,70 550,145 400,220 250,145" fill="var(--color-accent)" fill-opacity="0.14" stroke="var(--color-accent)" stroke-width="1.5" />
                    <!-- Left Face -->
                    <polygon points="250,145 400,220 400,340 250,265" fill="var(--color-accent)" fill-opacity="0.07" stroke="var(--color-accent)" stroke-width="1.5" />
                    <!-- Right Face -->
                    <polygon points="400,220 550,145 550,265 400,340" fill="var(--color-accent)" fill-opacity="0.2" stroke="var(--color-accent)" stroke-width="1.5" />

                    <!-- Internal volumetric grid lines -->
                    <line x1="325" y1="107" x2="325" y2="302" stroke="var(--color-accent)" stroke-dasharray="3 3" opacity="0.6" />
                    <line x1="475" y1="107" x2="475" y2="302" stroke="var(--color-accent)" stroke-dasharray="3 3" opacity="0.6" />
                    <line x1="250" y1="205" x2="400" y2="280" stroke="var(--color-accent)" opacity="0.5" />
                    <line x1="400" y1="280" x2="550" y2="205" stroke="var(--color-accent)" opacity="0.5" />

                    <!-- Rotating Orbit Ring -->
                    <ellipse cx="400" cy="220" rx="220" ry="75" stroke="var(--color-accent)" stroke-dasharray="4 6" opacity="0.45" />

                    <!-- Telemetry Vertices -->
                    <circle cx="400" cy="70" r="4" fill="var(--color-accent)" />
                    <circle cx="550" cy="145" r="4" fill="var(--color-accent)" />
                    <circle cx="250" cy="145" r="4" fill="var(--color-accent)" />
                    <circle cx="400" cy="220" r="5" fill="var(--color-text)" stroke="var(--color-accent)" stroke-width="2" />
                    <circle cx="400" cy="340" r="4" fill="var(--color-accent)" />
                    <circle cx="550" cy="265" r="4" fill="var(--color-accent)" />
                    <circle cx="250" cy="265" r="4" fill="var(--color-accent)" />
                  </g>

                  <!-- 3D HUD Telemetry Overlay -->
                  <text x="30" y="45" font-family="monospace" font-size="10" fill="var(--color-accent)" opacity="0.9">[3D_VOLUME_RENDERER: INITIALISED]</text>
                  <text x="30" y="65" font-family="monospace" font-size="9" fill="var(--color-text-faint)">PROJECTION: ISOMETRIC AXONOMETRIC · ROTATION: ACTIVE</text>
                  <text x="30" y="80" font-family="monospace" font-size="9" fill="var(--color-text-faint)">POLYGONS: 1,024 TRIS · TEXTURE_PASS: 1-BIT DITHER READY</text>
                  <text x="630" y="375" font-family="monospace" font-size="9" fill="var(--color-accent)">[FPS: 60.0_STABLE]</text>
                </svg>
              </div>
              <figcaption class="cinematic-3d-caption u-mono u-text-xs u-border-1bit-top">
                <span class="u-text-accent">CINEMATIC 3D INFOGRAPHIC MESH</span>
                <span class="u-text-faint">EDGE DESIGN SYSTEM · ISOMETRIC SPATIAL VOLUME</span>
              </figcaption>
            </div>
          </DesktopWindow>
        ) : (
          <CaseStudyDiagram id={slug} figureTag={d.figureTag ?? 'Fig. 01'} />
        )}
      </section>

      <!-- MDX body content -->
      <div class="case-prose">
        <Content />
      </div>

      <!-- [O:REF] Academic Rigor & Grounding -->
      {resolvedPublications.length > 0 && (
        <section class="case-grounding u-border-1bit" aria-labelledby="grounding-heading">
          <div class="case-grounding__header">
            <h2 id="grounding-heading" class="u-mono u-text-xs u-text-accent u-tracking-widest u-uppercase">
              [O:REF] ACADEMIC RIGOR & GROUNDING
            </h2>
            <span class="u-mono u-text-xs u-text-faint">
              {resolvedPublications.length} Peer-Reviewed Citation{resolvedPublications.length > 1 ? 's' : ''}
            </span>
          </div>
          <div class="case-grounding__list">
            {resolvedPublications.map((pub: any) => (
              <article class="case-grounding__item">
                <h3 class="case-grounding__pub-title">
                  {pub.data.url ? (
                    <a href={pub.data.url} target="_blank" rel="noopener noreferrer">
                      {pub.data.title} ↗
                    </a>
                  ) : pub.data.title}
                </h3>
                <p class="case-grounding__meta u-mono u-text-xs u-text-muted">
                  {pub.data.authors.join(', ')} · <em>{pub.data.venue}</em>
                  {pub.data.doi && (
                    <span class="case-grounding__doi">
                      · DOI: <a href={`https://doi.org/${pub.data.doi}`} target="_blank" rel="noopener noreferrer" class="u-text-accent">{pub.data.doi}</a>
                    </span>
                  )}
                </p>
                {pub.data.abstract && (
                  <p class="case-grounding__abstract u-text-sm u-text-muted">
                    {pub.data.abstract}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Methods + Tools + Deliverables -->
      <footer class="case-footer">
        {d.methods && d.methods.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Methods
            </h2>
            <ul class="tag-cloud" aria-label="Research methods">
              {d.methods.map((m: string) => <li class="tag">{m}</li>)}
            </ul>
          </div>
        )}
        {d.tools && d.tools.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Tools
            </h2>
            <ul class="tag-cloud" aria-label="Tools used">
              {d.tools.map((t: string) => <li class="tag">{t}</li>)}
            </ul>
          </div>
        )}
        {d.deliverables && d.deliverables.length > 0 && (
          <div class="case-footer__group">
            <h2 class="case-footer__heading u-mono u-text-xs u-tracking-widest u-uppercase u-text-faint">
              Deliverables
            </h2>
            <ul class="tag-cloud" aria-label="Deliverables">
              {d.deliverables.map((del: string) => <li class="tag">{del}</li>)}
            </ul>
          </div>
        )}
      </footer>
    </DesktopWindow>

    <!-- Next case studies -->
    <nav class="case-next" aria-label="More case studies">
      <a href="/work" class="btn-ghost u-mono u-text-xs">View All Case Studies →</a>
    </nav>

    <!-- Crimson Gradient CTA Banner -->
    <section class="section-bio" aria-label="Work with Fotis" style="margin-top: var(--space-12);">
      <div class="crimson-bio-banner">
        <div class="bio-banner__left">
          <h2 class="bio-banner__title">
            Hi, I'm Fotis. I make the complicated feel considered.
          </h2>
          <p class="bio-banner__desc">
            Senior UX Researcher & Systems Architect with 10+ years navigating high-stakes, regulated environments with Pfizer and Deloitte. Specializing in clinical interfaces, OOUX, and design systems for mission-critical software.
          </p>
        </div>

        <div class="bio-banner__right">
          <span class="bio-kicker">OPEN FOR ADVISORY & ROLES</span>
          <a href="/#contact-drawer" class="btn-discovery-cta">
            Book a discovery call <span class="arrow-right" aria-hidden="true">→</span>
          </a>
          <button type="button" class="btn-copy-email" id="caseCopyEmailBtn">
            <span id="caseCopyEmailText">Copy email</span>
          </button>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  function initCaseScripts() {
    const copyBtn = document.getElementById('caseCopyEmailBtn');
    const copyText = document.getElementById('caseCopyEmailText');
    if (copyBtn && copyBtn.dataset.listener !== 'true') {
      copyBtn.dataset.listener = 'true';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard?.writeText('fotispastrakis@gmail.com').then(() => {
          if (copyText) {
            const orig = copyText.textContent;
            copyText.textContent = 'Copied to clipboard!';
            setTimeout(() => {
              copyText.textContent = orig;
            }, 2500);
          }
        });
      });
    }
  }

  initCaseScripts();
  document.addEventListener('astro:page-load', initCaseScripts);
</script>

<style>
  .case-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: calc(var(--systembar-height) + var(--space-6));
    padding-bottom: var(--space-6);
  }

  .case-nav__back {
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: var(--tracking-wide);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }
  .case-nav__back:hover { color: var(--color-accent); }

  .case-article {
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  /* ── Article header ─────────────────────── */
  .case-header {
    padding: var(--space-10) var(--space-8) var(--space-8);
    border-bottom: var(--border-1bit);
  }

  .case-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-5);
  }

  .tag { display: inline-block; padding: 2px var(--space-2); font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-faint); border: var(--border-1bit-subtle); letter-spacing: var(--tracking-wide); text-decoration: none; }
  .tag--category { color: var(--color-text-muted); border-color: var(--color-border); }
  .tag--protected { color: var(--color-accent); border-color: var(--color-accent); }
  .tag--service { color: var(--color-text); border-color: var(--color-accent); background-color: rgba(238, 38, 38, 0.08); transition: background-color var(--duration-fast) var(--ease-out-quart); }
  .tag--service:hover { background-color: rgba(238, 38, 38, 0.2); }

  .case-header__services {
    margin-top: var(--space-6);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-border);
  }

  .service-badges {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  /* ── Academic Grounding ─────────────────── */
  .case-grounding {
    padding: var(--space-8);
    background-color: var(--color-surface-sunken);
    border-bottom: var(--border-1bit);
  }

  .case-grounding__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .case-grounding__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-grounding__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-bottom: var(--space-4);
    border-bottom: 1px dashed var(--color-border);
  }
  .case-grounding__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .case-grounding__pub-title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }
  .case-grounding__pub-title a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out-quart);
  }
  .case-grounding__pub-title a:hover {
    color: var(--color-accent);
  }

  .case-grounding__meta {
    line-height: var(--leading-normal);
  }

  .case-grounding__abstract {
    line-height: var(--leading-relaxed);
    max-width: 68ch;
  }

  .case-header__title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .case-header__tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 70ch;
    margin-bottom: var(--space-8);
  }

  .case-header__credits {
    display: flex;
    gap: var(--space-10);
    flex-wrap: wrap;
  }

  .case-header__credits dt { margin-bottom: var(--space-1); }
  .case-header__credits dd { margin: 0; }

  /* ── Impact band ────────────────────────── */
  .case-impact {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    border-bottom: var(--border-1bit);
  }

  .case-impact__item {
    flex: 1;
    min-width: 140px;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6) var(--space-8);
    border-right: var(--border-1bit);
  }

  .case-impact__item:last-child { border-right: none; }

  .case-impact__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: var(--weight-black);
    color: var(--color-accent);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .case-impact__metric {
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .case-impact__context { color: var(--color-text-faint); }

  /* ── Problem / Outcome ──────────────────── */
  .case-columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-bottom: var(--border-1bit);
  }

  @media (min-width: 768px) {
    .case-columns { grid-template-columns: 1fr 1fr; }
  }

  .case-columns__block {
    padding: var(--space-8);
    border-right: var(--border-1bit);
  }

  .case-columns__block:last-child { border-right: none; }

  .case-columns__heading {
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-3);
  }

  .case-columns__body {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
  }

  /* ── Process ────────────────────────────── */
  .case-process {
    padding: var(--space-8);
    border-bottom: var(--border-1bit);
  }

  .case-section-heading {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: var(--space-6);
  }

  .case-process__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .case-process__phase {
    display: grid;
    grid-template-columns: 32px 1fr;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    border-bottom: var(--border-1bit-subtle);
