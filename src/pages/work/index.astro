---
// src/pages/work/index.astro
// Work index — Interactive domain-filtered case studies directory
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyFilter from '../../components/CaseStudyFilter';
import { getCollection } from 'astro:content';

const caseStudies = (await getCollection('caseStudies', e => e.data.status === 'published'))
  .sort((a, b) => a.data.order - b.data.order);

const serializedCaseStudies = caseStudies.map(entry => ({
  id: entry.id.replace(/\.mdx?$/, ''),
  title: entry.data.title,
  tagline: entry.data.tagline,
  category: entry.data.category,
  year: entry.data.year,
  duration: entry.data.duration,
  protected: entry.data.protected,
  figureTag: entry.data.figureTag,
  problem: entry.data.problem,
  outcome: entry.data.outcome,
  impact: entry.data.impact,
}));
---

<BaseLayout
  title="Work & Case Studies — Fotis Pastrakis"
  description="Verified case studies in clinical UX, civic intelligence, calm health systems, and e-commerce architecture by Fotis Pastrakis."
>
  <div class="u-container work-index">
    <!-- Header -->
    <header class="work-index__header">
      <div class="work-index__meta">
        <span class="section-label" aria-hidden="true">fp://work/case-studies</span>
        <span class="u-mono u-text-xs u-text-faint">{caseStudies.length} specifications loaded</span>
      </div>
      <h1 class="work-index__title">Case Studies & Systems</h1>
      <p class="work-index__intro">
        In-depth breakdowns of production systems, research findings, and interaction architectures designed for complex domains — from emergency ICU floors to municipal operations centres.
      </p>
    </header>

    <!-- Interactive Filter & Directory -->
    <CaseStudyFilter client:load items={serializedCaseStudies} mode="directory" />
  </div>
</BaseLayout>

<style>
  .work-index {
    padding-top: calc(var(--systembar-height) + var(--space-12));
    padding-bottom: var(--space-24);
  }

  .work-index__header {
    margin-bottom: var(--space-12);
  }

  .work-index__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .work-index__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }

  .work-index__intro {
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 64ch;
  }

  .work-index__grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .case-card-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-card-inner__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tag {
    display: inline-block;
    padding: 2px var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
    border: var(--border-1bit-subtle);
    letter-spacing: var(--tracking-wide);
  }

  .tag--category {
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }

  .tag--protected {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .case-card-inner__heading {
    margin: 0;
  }

  .case-card-inner__title-link {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    text-decoration: none;
    line-height: var(--leading-snug);
    transition: color var(--duration-fast) var(--ease-out-quart);
  }

  .case-card-inner__title-link:hover {
    color: var(--color-accent);
  }

  .case-card-inner__tagline {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .case-card-inner__dual {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    background-color: var(--color-surface-raised);
    border: var(--border-1bit-subtle);
  }

  @media (min-width: 768px) {
    .case-card-inner__dual {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  .dual-col__label {
    display: block;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-1);
  }

  .dual-col__text {
    line-height: var(--leading-normal);
  }

  .case-card-inner__metrics {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-top: var(--space-2);
  }

  .metric-pill {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .metric-pill__val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    color: var(--color-accent);
    line-height: 1;
  }

  .metric-pill__name {
    color: var(--color-text-faint);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .case-card-inner__actions {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
  }

  .btn-read-case {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background-color: transparent;
    color: var(--color-text-muted);
    border: var(--border-1bit);
    text-decoration: none;
    letter-spacing: var(--tracking-wide);
    transition: all var(--duration-fast) var(--ease-out-quart);
  }

  .btn-read-case:hover {
    background-color: var(--color-accent);
    color: var(--color-text);
    border-color: var(--color-accent);
  }
</style>
